{
  "nr": 6,
  "titel": {
    "latein": "Bayto",
    "syrisch": "ܒܰܝܬܐ",
    "deutsch": "Haus",
    "audio": "https://textbook.surayt.com/de/files/17314.mp3"
  },
  "textTitel": {
    "latein": "Bayto ḥaṯo",
    "syrisch": "ܒܰܝܬܐ ܚܰܬ̣ܐ",
    "deutsch": "Ein neues Haus",
    "audio": "https://textbook.surayt.com/de/files/17334.mp3"
  },
  "quelle": {
    "name": "Šlomo Surayt",
    "url": "https://textbook.surayt.com/de/Online%20Course/1.6",
    "abgerufen": "2026-11-16"
  },
  "einleitung": [
    {
      "id": "L06-E-01",
      "latein": "I iqarṯo d Be Marawge këtla arbco nacime.",
      "syrisch": "ܐܝ ܐܝܩܰܪܬ݂ܐ ܕܒܶܐ ܡܰܪܰܘܓܶܐ ܟܷܬܠܰܗ ܐܰܪܒܥܐ ܢܰܥܝܡܶܐ.",
      "deutsch": "Die Familie Be Marawge hat vier Kinder.",
      "audio": "https://textbook.surayt.com/de/files/17315.mp3",
      "lektion": 6,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L06-E-02",
      "latein": "I Saro w u Aday cawode ne w koyëtwi b bayto b Amsterdam.",
      "syrisch": "ܐܝ ܣܰܪܐ ܘܐܘ ܐܰܕܰܝ ܥܰܘܳܕܶܐ ܢܶܐ ܘܟܳܝܷܬܘܝ ܒܒܰܝܬܐ ܒܐܰܡܣܬܷܪܕܰܡ.",
      "deutsch": "Saro und Aday sind berufstätig und wohnen in einem Haus (in einer Wohnung) in Amsterdam.",
      "audio": "https://textbook.surayt.com/de/files/17316.mp3",
      "lektion": 6,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L06-E-03",
      "latein": "Cal di këre du bayto celayto yo, këbci zawni bayto aw macamri bayto.",
      "syrisch": "ܥܰܠ ܕܝ ܟܷܪܶܐ ܕܘ ܒܰܝܬܐ ܥܶܠܰܝܬܐ ܝܐ، ܟܐܷܒܥܝ ܙܰܘܢܝ ܒܰܝܬܐ ܐܰܘ ܡܰܥܰܡܪܝ ܒܰܝܬܐ.",
      "deutsch": "Weil die Miete hoch ist, wollen sie ein Haus kaufen oder bauen.",
      "audio": "https://textbook.surayt.com/de/files/17317.mp3",
      "lektion": 6,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L06-E-04",
      "latein": "Bi ḥarayto markawwe u rëcyonaṯṯe cal tëcmiro d bayto.",
      "syrisch": "ܒܝ ܚܰܪܰܝܬܐ ܡܰܪܟܰܘܘܶܗ ܐܘ ܪܷܥܝܳܢܰܬ݂ܬ݂ܶܗ ܥܰܠ ܬܷܥܡܝܪܐ ܕܒܰܝܬܐ.",
      "deutsch": "Zum Schluss entscheiden sie sich für den Bau eines Hauses.",
      "audio": "https://textbook.surayt.com/de/files/17318.mp3",
      "lektion": 6,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    }
  ],
  "text": [
    {
      "id": "L06-D-01",
      "latein": "I Saro w u Aday mšaralle d kurxi cal arco d macamri.",
      "syrisch": "ܐܝ ܣܰܪܐ ܘܐܘ ܐܰܕܰܝ ܡܫܰܪܰܠܠܶܗ ܕܟܘܪܟ݂ܝ ܥܰܠ ܐܰܪܥܐ ܕܡܰܥܰܡܪܝ.",
      "deutsch": "Saro und Aday haben angefangen, nach einem Grundstück zum Bauen zu suchen.",
      "audio": "https://textbook.surayt.com/de/files/17335.mp3",
      "lektion": 6,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L06-D-02",
      "latein": "Karixi harke w tamo mqafalle arco bë ḥḏo maš šawṯoṯe ḥaṯe d Amsterdam.",
      "syrisch": "ܟܰܪܝܟ݂ܝ ܗܰܪܟܶܐ ܘܬܰܡܐ، ܡܩܰܦܰܠܠܶܗ ܐܰܪܥܐ ܒܷܚܕ݂ܐ ܡܰܫ ܫܰܘܬܼܳܬ̣ܶܐ ܚܰܬ݂ܶܐ ܕܐܰܡܣܬܷܪܕܰܡ.",
      "deutsch": "Sie haben hier und da gesucht und ein Grundstück in einem der neuen Stadtviertel von Amsterdam gefunden.",
      "audio": "https://textbook.surayt.com/de/files/17336.mp3",
      "lektion": 6,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L06-D-03",
      "latein": "B zabno karyo azzën gab aršitakt w abici mene d rošam plan d bayto lašanayye.",
      "syrisch": "ܒܙܰܒܢܐ ܟܰܪܝܐ ܐܰܙܙܷܢ ܓܰܒ ܐܰܪܫܝܬܰܟܬ ܘܐܰܒܝܥܝ ܡܶܢܶܗ ܕܪܳܫܰܡ ܦ̇ܠܰܢ ܕܒܰܝܬܐ ܠܰܫܰܢܰܝܝܶܗ.",
      "deutsch": "In kürzester Zeit sind sie zu einem Architekten gegangen, mit der Bitte, ihnen einen Plan zu erstellen.",
      "audio": "https://textbook.surayt.com/de/files/17337.mp3",
      "lektion": 6,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L06-D-04",
      "latein": "U aršitakt ršëmle plan d bayto alle xud abici.",
      "syrisch": "ܐܘ ܐܰܪܫܝܬܰܟܬ ܪܫܷܡܠܶܗ ܦ̇ܠܰܢ ܕܒܰܝܬܐ ܐܰܠܠܶܗ ܟ݂ܘܕ ܐܰܒܝܥܝ.",
      "deutsch": "Der Architekt erstellte ihnen einen Grundrissplan nach ihren Wünschen.",
      "audio": "https://textbook.surayt.com/de/files/17338.mp3",
      "lektion": 6,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L06-D-05",
      "latein": "Maḥwele u plan alle w šrëḥle u mede dë ršëmle:",
      "syrisch": "ܡܰܚܘܶܠܶܗ ܐܘ ܦ̇ܠܰܢ ܐܰܠܠܶܗ ܘܫܪܷܚܠܶܗ ܐܘ ܡܶܕܶܐ ܕܷܪܫܷܡܠܶܗ:",
      "deutsch": "Er zeigte ihnen den Plan und erklärte ihnen, was er gezeichnet hatte:",
      "audio": "https://textbook.surayt.com/de/files/17339.mp3",
      "lektion": 6,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L06-D-06",
      "latein": "i rabuṯo du bayto, aq qeloyoṯe, i ganṯo, aš šaboke, u maṭbax, i tuwalet, u banyo w kul mede d lozamwa.",
      "syrisch": "ܐܝ ܪܰܒܘܬ݂ܐ ܕܘ ܒܰܝܬܐ، ܐܰܩ ܩܶܠܳܝܳܬ݂ܶܐ، ܐܝ ܓܰܢܬ݂ܐ، ܐܰܫ ܫܰܒܳܟܶܐ، ܐܘ ܡܰܛܒܰܟ݂، ܐܝ ܬܘܘܰܠܶܬ، ܐܘ ܒܰܐܢܝܐ ܘܟܘܠ ܡܶܕܶܐ ܕܠܳܙܰܡܘܰܐ.",
      "deutsch": "die Maße des Hauses, die Zimmer, den Garten, die Fenster, die Küche, die Toilette, das Badezimmer und alles, was nötig war.",
      "audio": "https://textbook.surayt.com/de/files/17340.mp3",
      "lektion": 6,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L06-D-07",
      "latein": "I Saro w u Aday bëṯër me d raḏën cal u plan, azzën li baladiye d ṭëlbi fsoso lu tëcmiro.",
      "syrisch": "ܐܝ ܣܰܪܐ ܘܐܘ ܐܰܕܰܝ ܒܷܬ݂ܷܪ ܡܶܐ ܕܪܰܕ݂ܷܢ ܥܰܠ ܐܘ ܦ̇ܠܰܢ، ܐܰܙܙܷܢ ܠܝ ܒܰܠܰܕܝـܝܶܐ ܕܛܷܠܒܝ ܦܣܳܣܐ ܠܘ ܬܷܥܡܝܪܐ.",
      "deutsch": "Nachdem Saro und Aday mit dem Plan einverstanden waren, gingen sie zur Stadtverwaltung (d.h. Bauamt), um eine Baugenehmigung zu beantragen.",
      "audio": "https://textbook.surayt.com/de/files/17341.mp3",
      "lektion": 6,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L06-D-08",
      "latein": "B cayni zabno ste mšaralle d kurxi cal šërke du tëcmiro.",
      "syrisch": "ܒܥܰܝܢܝ ܙܰܒܢܐ ܣܬܶܐ ܡܫܰܪܰܠܠܶܗ ܕܟܘܪܟ݂ܝ ܥܰܠ ܫܷܪܟܶܐ ܕܘ ܬܷܥܡܝܪܐ.",
      "deutsch": "Zur selben Zeit suchten sie eine Baufirma.",
      "audio": "https://textbook.surayt.com/de/files/17342.mp3",
      "lektion": 6,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L06-D-09",
      "latein": "I baladiye b zabno d yarḥo madcarla xabro aclayye w hula alle fsoso.",
      "syrisch": "ܐܝ ܒܰܠܰܕܝـܝܶܐ ܒܙܰܒܢܐ ܕܝܰܪܚܐ ܡܰܕܥܰܪܠܰܗ ܟ݂ܰܒܪܐ ܐܰܥܠܰܝـܝܶܗ ܘܗܘܠܰܗ ܐܰܠܠܶܗ ܦܣܳܣܐ.",
      "deutsch": "Die Stadtverwaltung antwortete ihnen innerhalb eines Monats und gab ihnen eine Baugenehmigung.",
      "audio": "https://textbook.surayt.com/de/files/17343.mp3",
      "lektion": 6,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L06-D-10",
      "latein": "Elo šërke lu tëcmiro xayifo lo mqafalle, miḏe d mëjġalle w mbayzarre cam šërkat ġalabe. Bi ḥarayto mqafalle ḥḏo.",
      "syrisch": "ܐܶܠܐ ܫܷܪܟܶܐ ܠܘ ܬܷܥܡܝܪܐ ܟ݂ܰܝـܝܦܐ ܠܐ ܡܩܰܦܰܠܠܶܗ، ܡܝܕ݂ܶܗ ܕܡܷܔܓ݂ܰܠܠܶܗ ܘܡܒܰܝܙܰܪܪܶܗ ܥܰܡ ܫܷܪܟܰܬ ܓ݂ܰܠܰܒܶܐ. ܒܝ ܚܰܪܰܝܬܐ ܡܩܰܦܰܠܠܶܗ ܚܕ݂ܐ.",
      "deutsch": "Doch eine Baufirma fanden sie nicht so schnell, weil sie mit vielen Firmen sprachen und verhandelten. Schließlich fanden sie eine (Firma).",
      "audio": "https://textbook.surayt.com/de/files/17344.mp3",
      "lektion": 6,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L06-D-11",
      "latein": "Bëṯër me d hënne w i šërke aṯën lë ḥḏoḏe, i Saro w u Aday azzën dë mnaqën u matëryal du tëcmiro.",
      "syrisch": "ܒܷܬ݂ܷܪ ܡܶܐ ܕܗܷܢܢܶܐ ܘܐܝ ܫܷܪܟܶܐ ܐܰܬ݂ܷܢ ܠܷܚܕ݂ܳܕ݂ܶܐ، ܐܝ ܣܰܪܐ ܘܐܘ ܐܰܕܰܝ ܐܰܙܙܷܢ ܕܷܡܢܰܩܷܢ ܐܘ ܡܰܬܷܪܝܰܠ ܕܘ ܬܷܥܡܝܪܐ.",
      "deutsch": "Nachdem sie sich mit der Baufirma geeinigt hatten, gingen Saro und Aday das Baumaterial aussuchen.",
      "audio": "https://textbook.surayt.com/de/files/17345.mp3",
      "lektion": 6,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L06-D-12",
      "latein": "Mnaqalle ak kefe, aš šaboke, i boya, u kaġat w ġer medone.",
      "syrisch": "ܡܢܰܩܰܠܠܶܗ ܐܰܟ ܟܶܦܶܐ، ܐܰܫ ܫܰܒܳܟܶܐ، ܐܝ ܒܳܝܰܐ، ܐܘ ܟܰܓ݂ܰܬ ܘܓ݂ܶܪ ܡܶܕܳܢܶܐ.",
      "deutsch": "Sie suchten die Steine, die Fenster, die Farbe, die Tapeten und andere Materialien aus.",
      "audio": "https://textbook.surayt.com/de/files/17346.mp3",
      "lektion": 6,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L06-D-13",
      "latein": "Hawxa i šërke mšarela bu tëcmiro du bayto. Šafëc mëdde d šato, u bayto camër.",
      "syrisch": "ܗܰܘܟ݂ܰܐ ܐܝ ܫܷܪܟܶܐ ܡܫܰܪܶܠܰܗ ܒܘ ܬܷܥܡܝܪܐ ܕܘ ܒܰܝܬܐ. ܫܰܦܷܥ ܡܷܕܕܶܐ ܕܫܰܬܐ ܐܘ ܒܰܝܬܐ ܥܰܡܷܪ.",
      "deutsch": "Alsdann begann die Firma, das Haus zu bauen. Nach etwa einem Jahr war das Haus gebaut.",
      "audio": "https://textbook.surayt.com/de/files/17347.mp3",
      "lektion": 6,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L06-D-14",
      "latein": "Bëṯër mšaralle d malawši u bayto. Lo šafëc yarḥo i iqarṯo d Be Marawge nqila lu bayto ḥaṯo.",
      "syrisch": "ܒܷܬ݂ܷܪ ܡܫܰܪܰܠܠܶܗ ܕܡܰܠܰܘܫܝ ܐܘ ܒܰܝܬܐ. ܠܐ ܫܰܦܷܥ ܝܰܪܚܐ ܐܝ ܐܝܩܰܪܬ݂ܐ ܕܒܶܐ ܡܰܪܰܘܓܶܐ ܢܩܝܠܰܗ ܠܘ ܒܰܝܬܐ ܚܰܬ݂ܐ.",
      "deutsch": "Danach möblierten sie das Haus aus. Nach einem knappen Monat zog die Familie Be Marawge in das neue Haus ein.",
      "audio": "https://textbook.surayt.com/de/files/17348.mp3",
      "lektion": 6,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    }
  ],
