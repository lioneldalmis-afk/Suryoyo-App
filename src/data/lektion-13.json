{
  "nr": 13,
  "titel": {
    "latein": "Ceḏo zcuro bu Swed",
    "syrisch": "ܥܶܕ݂ܐ ܙܥܘܪܐ ܒܘ ܣܘܶܕܐ",
    "deutsch": "Weihnachten in Schweden",
    "audio": "https://textbook.surayt.com/files/22295.mp3"
  },
  "textTitel": {
    "latein": "Ceḏo zcuro w riša d šato bu Swed",
    "syrisch": "ܥܶܕ݂ܐ ܙܥܘܪܐ ܘܪܝܫܰܗ ܕܫܰܬܐ ܒܘ ܣܘܶܕ",
    "deutsch": "Weihnachten und Neujahr in Schweden",
    "audio": "https://textbook.surayt.com/files/22319.mp3"
  },
  "quelle": {
    "name": "Šlomo Surayt",
    "url": "https://textbook.surayt.com/de/Online%20Course/1.13",
    "abgerufen": "2026-11-16"
  },
  "einleitung": [
    {
      "id": "L13-E-01",
      "latein": "I Iqarṯo d be Marawge kocayšo b aṯrawoṯe mšaḥëlfe d Awrupa.",
      "syrisch": "ܐܝ ܐܝܩܰܪܬ݂ܐ ܕܒܶܐ ܡܰܪܰܘܓܶܐ ܟܳܥܰܝܫܐ ܒܐܰܬ݂ܪܰܘܳܬ݂ܶܐ ܡܫܰܚܷܠܦܶܐ ܕܐܰܘܪܘܦ݁ܰܐ.",
      "deutsch": "Die Familie Be Marawge lebt in verschiedenen Ländern Europas.",
      "audio": "https://textbook.surayt.com/files/22296.mp3",
      "lektion": 13,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L13-E-02",
      "latein": "Ah hadome di iqarṯo me zabno l zabno kozayri ḥḏoḏe, lašan di asiruṯaṯṯe mdawmo.",
      "syrisch": "ܐܰܗ ܗܰܕܳܡܶܐ ܕܝ ܐܝܩܰܪܬ݂ܐ ܡܶܐ ܙܰܒܢܐ ܠܙܰܒܢܐ ܟܳܙܰܝܪܝ ܚܕ݂ܳܕ݂ܶܐ ܠܰܫܰܢ ܕܝ ܐܰܣܝܪܘܬ݂ܰܬ݂ܬ݂ܶܗ ܡܕܰܘܡܐ.",
      "deutsch": "Die Mitglieder der Familie besuchen sich gegenseitig von Zeit zu Zeit, damit ihre Beziehung erhalten bleibt.",
      "audio": "https://textbook.surayt.com/files/22297.mp3",
      "lektion": 13,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L13-E-03",
      "latein": "B ḥa ramšo meqëm me ceḏo zcuro, i Saro w u Aday cam an nacime mqararre dë mcayḏi u ceḏo adšato bu Swed cam an nošaṯṯe:",
      "syrisch": "ܒܚܰܐ ܪܰܡܫܐ ܡܶܩܷܡ ܡܶܐ ܥܶܕ݂ܐ ܙܥܘܪܐ ܐܝ ܣܰܪܐ ܘܐܘ ܐܰܕܰܝ ܥܰܡ ܐܰܢ ܢܰܥܝܡܶܐ ܡܩܰܪܰܪܪܶܗ ܕܷܡܥܰܝܕ݂ܝ ܐܘ ܥܶܕ݂ܐ ܐܰܕܫܰܬܐ ܒܘ ܣܘܶܕ ܥܰܡ ܐܰܢ ܢܳܫܰܬ݂ܬ݂ܶܗ.",
      "deutsch": "Eines Abends vor Weihnachten entschieden Saro und Aday mit den Kindern, Weihnachten dieses Jahr mit ihren Verwandten in Schweden zu verbringen:",
      "audio": "https://textbook.surayt.com/files/22298.mp3",
      "lektion": 13,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    }
  ],
  "text": [
    {
      "id": "L13-D-01",
      "latein": "U Aday komtalfan lu aḥuno w komar le:",
      "syrisch": "ܐܘ ܐܰܕܰܝ ܟܳܡܬܰܠܦܰܢ ܠܘ ܐܰܚܘܢܐ ܘܟܐܡܰܪ ܠܶܗ:",
      "deutsch": "Aday ruft seinen Bruder an und fragt ihn:",
      "audio": "https://textbook.surayt.com/files/22320.mp3",
      "lektion": 13,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L13-D-02",
      "latein": "„Aḥuno, iḏa layt këlyono, këbcina bu ceḏano zayrina lxu.“",
      "syrisch": "ܐܰܚܘܢܐ، ܐܝܕ݂ܰܐ ܠܰܝܬ ܟܷܠܝܳܢܐ، ܟܐܷܒܥܝܢܰܐ ܒܘ ܥܶܕ݂ܰܢܐ ܙܰܝܪܝܢܰܐ ܠܟ݂ܘ.",
      "deutsch": "Bruder, wenn nichts dagegen spricht, wollen wir euch zu diesem Weihnachtsfest besuchen.",
      "audio": "https://textbook.surayt.com/files/22321.mp3",
      "lektion": 13,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L13-D-03",
      "latein": "U aḥuno komar, „ašër komarno layt këlyono, elo gëd mšayalno an nacime be lo mcayarre mede dlo meni. Bëṯër gëd madcarno xabro aclux.“",
      "syrisch": "ܐܘ ܐܰܚܘܢܐ ܟܐܡܰܪ، ܐܰܫܷܪ ܟܐܡܰܪܢܐ ܠܰܝܬ ܟܷܠܝܳܢܐ، ܐܶܠܐ ܓܷܕ ܡܫܰܝܰܠܢܐ ܐܰܢ ܢܰܥܝܡܶܐ ܒܶܐ ܠܐ ܡܥܰܝܰܪܪܶܗ ܡܶܕܶܐ ܕܠܐ ܡܶܢܝ. ܒܷܬ݂ܷܪ ܓܶܕ ܡܰܕܥܰܪܢܐ ܟ݂ܰܒܪܐ ܐܰܥܠܘܟ݂.",
      "deutsch": "Sein Bruder antwortet: “Nun, ich denke, wir haben nichts (wor). Ich will aber die Kinder fragen, ob sie nicht ohne mein Wissen etwas geplant haben. Dann werde ich dir Bescheid geben.”",
      "audio": "https://textbook.surayt.com/files/23200.mp3",
      "lektion": 13,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L13-D-04",
      "latein": "„Ṭawwo!“ komar u Aday.",
      "syrisch": "ܛܰܘܘܐ ܟܐܡܰܪ ܐܘ ܐܰܕܰܝ.",
      "deutsch": "„Gut!“ sagt Aday.",
      "audio": "https://textbook.surayt.com/files/23201.mp3",
      "lektion": 13,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L13-D-05",
      "latein": "Deri yawmo u Yacqub u aḥuno du Aday komadcar xabro w komar, „aḥuno layt këlyono mu maṯyaṯxu.",
      "syrisch": "ܕܶܪܝ ܝܰܘܡܐ ܐܘ ܝܰܥܩܘܒ ܐܘ ܐܰܚܘܢܐ ܕܘ ܐܰܕܰܝ ܟܳܡܰܕܥܰܪ ܟ݂ܰܒܪܐ ܘܟܐܡܰܪ، ܐܰܚܘܢܐ ܠܰܝܬ ܟܷܠܝܳܢܐ ܡܘ ܡܰܬ݂ܝܰܬ݂ܟ݂ܘ.",
      "deutsch": "Am folgenden Tag gibt Jakob, der Bruder von Aday, Bescheid und sagt: „Bruder, es spricht nichts gegen euren Besuch.",
      "audio": "https://textbook.surayt.com/files/22324.mp3",
      "lektion": 13,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L13-D-06",
      "latein": "B šayno w bë šlomo apxu. Gëd mëfṣoḥina ġalabe d ḥozina lxu baynoṯan bu ceḏo.“",
      "syrisch": "ܒܫܰܝܢܐ ܘܒܷܫܠܳܡܐ ܐܰܦ݁ܟ݂ܘ. ܓܷܕ ܡܷܦܨܳܚܝܢܰܐ ܓ݂ܰܠܰܒܶܐ ܕܚܳܙܝܢܰܐ ܠܟ݂ܘ ܒܰܝܢܳܬ݂ܰܝܢܰܐ ܒܘ ܥܶܕ݂ܐ.",
      "deutsch": "Ihr seid willkommen. Wir werden uns sehr freuen, euch zu Weihnachten unter uns zu sehen.“",
      "audio": "https://textbook.surayt.com/files/22325.mp3",
      "lektion": 13,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L13-D-07",
      "latein": "„Tawdi ġalabe,“ komar u Aday „w fëš bë šlomo hul lu ceḏo.“",
      "syrisch": "ܬܰܘܕܝ ܓ݂ܰܠܰܒܶܐ، ܟܐܡܰܪ ܐܘ ܐܰܕܰܝ ܘܦܷܫ ܒܷܫܠܳܡܐ ܗܘܠ ܠܘ ܥܶܕ݂ܐ.",
      "deutsch": "„Vielen Dank,“ sagt Aday, „und tschüss, bis Weihnachten!“",
      "audio": "https://textbook.surayt.com/files/22326.mp3",
      "lektion": 13,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L13-D-08",
      "latein": "Meqëm me d ëzzën b šabto i Saro w an nacime mšaralle bu šqolo dad dëšne.",
      "syrisch": "ܡܶܩܷܡ ܡܶܐ ܕܐܷܙܙܷܢ ܒܫܰܒܬ݂ܐ ܐܝ ܣܰܪܐ ܘܐܰܢ ܢܰܥܝܡܶܐ ܡܫܰܪܰܠܠܶܗ ܒܘ ܫܩܳܠܐ ܕܰܕ ܕܷܫܢܶܐ.",
      "deutsch": "Eine Woche vor der Reise begannen Saro und die Kinder, die Geschenke zu kaufen.",
      "audio": "https://textbook.surayt.com/files/22327.mp3",
      "lektion": 13,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L13-D-09",
      "latein": "I Saro šqila dëšne li damṯo w lu barëḥmayḏa.",
      "syrisch": "ܐܝ ܣܰܪܐ ܫܩܝܠܰܗ ܕܷܫܢܶܐ ܠܝ ܕܰܡܬ݂ܐ ܘܠܘ ܒܰܪܷܚܡܰܝܕ݂ܰܗ.",
      "deutsch": "Saro kaufte Geschenke für ihre Schwägerin und für ihren Schwager.",
      "audio": "https://textbook.surayt.com/files/22328.mp3",
      "lektion": 13,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L13-D-10",
      "latein": "An nacime šqëlle dëšne lan abne du cammaṯṯe.",
      "syrisch": "ܐܰܢ ܢܰܥܝܡܶܐ ܫܩܷܠܠܶܗ ܕܷܫܢܶܐ ܠܰܢ ܐܰܒܢܶܐ ܕܘ ܥܰܡܡܰܬ݂ܬ݂ܶܗ.",
      "deutsch": "Die Kinder kauften Geschenke für die Söhne ihres Onkels.",
      "audio": "https://textbook.surayt.com/files/22329.mp3",
      "lektion": 13,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L13-D-11",
      "latein": "Mu gabo ḥreno ste cayni mede sëmme, xdi cade d kit gab as Suryoye.",
      "syrisch": "ܡܘ ܓܰܒܐ ܚܪܶܢܐ ܣܬܶܐ ܥܰܝܢܝ ܡܶܕܶܐ ܣܷܡܡܶܗ ܟ݂ܕܝ ܥܰܕܶܐ ܕܟܝܬ ܓܰܒ ܐܰܣ ܣܘܪܝܳܝܶܐ.",
      "deutsch": "Die andere Seite (der Familie) tat dies genauso, wie es bei den Aramäern/Assyrern üblich ist.",
      "audio": "https://textbook.surayt.com/files/22339.mp3",
      "lektion": 13,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L13-D-12",
      "latein": "Markawwe i dawmo du ceḏo w maḥatte ad dëšne taḥta.",
      "syrisch": "ܡܰܪܟܰܘܘܶܗ ܐܝ ܕܰܘܡܐ ܕܘ ܥܶܕ݂ܐ ܘܡܰܚܰܬܬܶܗ ܐܰܕ ܕܷܫܢܶܐ ܬܰܚܬܰܗ.",
      "deutsch": "Sie stellten den Weihnachtsbaum auf und legten die Geschenke darunter.",
      "audio": "https://textbook.surayt.com/files/22338.mp3",
      "lektion": 13,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L13-D-13",
      "latein": "Tre yawme meqëm mu ceḏo i iqarṯo d Be Marawge rawixo bi ṭayasto w azza lu Swed.",
      "syrisch": "ܬܪܶܐ ܝܰܘܡܶܐ ܡܶܩܷܡ ܡܘ ܥܶܕ݂ܐ ܐܝ ܐܝܩܰܪܬ݂ܐ ܕܒܶܐ ܡܰܪܰܘܓܶܐ ܪܰܘܝܟ݂ܐ ܒܝ ܛܰܝܰܣܬܐ ܘܐܰܙܙܰܗ ܠܘ ܣܘܶܕ.",
      "deutsch": "Zwei Tage vor Weihnachten stieg die Familie Be Marawge ins Flugzeug und flog nach Schweden.",
      "audio": "https://textbook.surayt.com/files/22337.mp3",
      "lektion": 13,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L13-D-14",
      "latein": "Yacqub, u aḥuno du Aday azze lu beṯ ṭawso dë Stokholm d moyadde.",
      "syrisch": "ܐܘ ܝܰܥܩܘܒ، ܐܘ ܐܰܚܘܢܐ ܕܘ ܐܰܕܰܝ ܐܰܙܙܶܗ ܠܘ ܒܶܬ݂ ܛܰܘܣܐ ܕܷܣـܛܳܟܗܳܠܡ ܕܡܳܝܰܕܕܶܗ.",
      "deutsch": "Jakob, der Bruder von Aday, fuhr zum Flughafen von Stockholm, um sie abzuholen.",
      "audio": "https://textbook.surayt.com/files/22336.mp3",
      "lektion": 13,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L13-D-15",
      "latein": "I iqarṯo kula fṣiḥo w mšayalle bu šlomo dë ḥḏoḏe.",
      "syrisch": "ܐܝ ܐܝܩܰܪܬ݂ܐ ܟܘܠܰܗ ܦܨܝܚܐ ܘܡܫܰܝܰܠܠܶܗ ܒܘ ܫܠܳܡܐ ܕܷܚܕ݂ܳܕ݂ܶܐ.",
      "deutsch": "Die ganze Familie freute sich, und sie erkundigten sich über das gegenseitige Wohlergehen.",
      "audio": "https://textbook.surayt.com/files/22335.mp3",
      "lektion": 13,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L13-D-16",
      "latein": "Yawme du ceḏo kulle lwëšše šafiro w azzën li cito.",
      "syrisch": "ܝܰܘܡܶܗ ܕܘ ܥܶܕ݂ܐ ܟܘܠܠܶܗ ܠܘܷܫܫܶܗ ܫܰܦܝܪܐ ܘܐܰܙܙܷܢ ܠܝ ܥܝܬܐ.",
      "deutsch": "Am Weihnachtstag zogen sich alle fein an und gingen in die Kirche.",
      "audio": "https://textbook.surayt.com/files/22334.mp3",
      "lektion": 13,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L13-D-17",
      "latein": "Mërre „ceḏo brixo“ lë ḥḏoḏe cam ḥubo w fṣiḥuṯo, w daciri mi cito lu bayto.",
      "syrisch": "ܡܷܪܪܶܗ ܥܶܕ݂ܐ ܒܪܝܟ݂ܐ ܠܷܚܕ݂ܳܕ݂ܶܐ ܥܰܡ ܚܘܒܐ ܘܦܨܝܚܘܬ݂ܐ ܘܕܰܥܝܪܝ ܡܝ ܥܝܬܐ ܠܘ ܒܰܝܬܐ.",
      "deutsch": "Sie sagten “Frohe Weihnachten!” zu einander in Liebe und Freude und kehrten nach Hause zurück.",
      "audio": "https://textbook.surayt.com/files/22333.mp3",
      "lektion": 13,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L13-D-18",
      "latein": "Bëṯër me d xëlle marga du ceḏo mfalaġġe ad dëšne.",
      "syrisch": "ܒܷܬ݂ܷܪ ܡܷܐ ܕܟ݂ܷܠܠܶܗ ܡܰܪܓܰܐ ܕܘ ܥܶܕ݂ܐ ܡܦܰܠܰܓ݂ܓ݂ܶܗ ܐܰܕ ܕܷܫܢܶܐ.",
      "deutsch": "Nachdem sie den Weihnachtseintopf “Marga” gegessen hatten, verteilten sie die Geschenke.",
      "audio": "https://textbook.surayt.com/files/22332.mp3",
      "lektion": 13,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L13-D-19",
      "latein": "Bëṯër me falge d yawmo an nacime nafiqi lu kroxo du ceḏo, lašan mcayḏi aḥ ḥawrone w an iḏice ḥrene ste.",
      "syrisch": "ܒܷܬ݂ܷܪ ܡܶܐ ܦܰܠܓܶܗ ܕܝܰܘܡܐ ܐܰܢ ܢܰܥܝܡܶܐ ܢܰܦܝܩܝ ܠܘ ܟܪܳܟ݂ܐ ܕܘ ܥܶܕ݂ܐ، ܠܰܫܰܢ ܡܥܰܝܕ݂ܝ ܐܰܚ ܚܰܘܪܳܢܶܐ ܘܐܰܢ ܐܝܕ݂ܝܥܶܐ ܚܪܢܶܐ ܣܬܶܐ.",
      "deutsch": "Am Nachmittag machten die Kinder den Weihnachtsumzug, um den Freunden und anderen Bekannten zum Fest zu gratulieren.",
      "audio": "https://textbook.surayt.com/files/22331.mp3",
      "lektion": 13,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L13-D-20",
      "latein": "I Iqarṯo d Be Marawge fayišo bu Swed hul riša di šato ḥaṯto. Bëṯër me riša d šato daciri lu bayto, l Holanda.",
      "syrisch": "ܐܝ ܐܝܩܰܪܬ݂ܐ ܕܒܶܐ ܡܰܪܰܘܓܶܐ ܦܰܝـܝܫܐ ܒܘ ܣܘܶܕ ܗܘܠ ܪܝܫܰܗ ܕܝ ܫܰܬܐ ܚܰܬ݂ܬܐ. ܒܷܬ݂ܷܪ ܡܶܐ ܪܝܫܰܗ ܕܫܰܬܐ ܕܰܥܝܪܝ ܠܘ ܒܰܝܬܐ، ܠܗܳܠܰܢܕܰܐ.",
      "deutsch": "Die Familie Be Marawge blieb in Schweden bis Neujahr. Nach Neujahr sind sie nach Hause in die Niederlande zurückgeflogen.",
      "audio": "https://textbook.surayt.com/files/22330.mp3",
      "lektion": 13,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    }
  ],
  "wortschatz": [
    {
