      "syrisch": "ܐܰܔ ܔܝܪܰܢܶܐ",
      "deutsch": "die Nachbarn",
      "audio": "https://textbook.surayt.com/files/22412.mp3",
      "audio2": "https://textbook.surayt.com/files/21325.mp3",
      "lektion": 13,
      "art": "wort",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L13-W-xelle",
      "latein": "xëlle",
      "syrisch": "ܟ݂ܷܠܠܶܗ",
      "deutsch": "sie aßen",
      "audio": "https://textbook.surayt.com/files/22413.mp3",
      "audio2": "https://textbook.surayt.com/files/21326.mp3",
      "lektion": 13,
      "art": "wort",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
