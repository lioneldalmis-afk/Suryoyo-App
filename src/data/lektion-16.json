{
  "nr": 16,
  "titel": {
    "latein": "Ṭlobo w Gworo",
    "syrisch": "ܛܠܳܒܐ ܘܓܘܳܪܐ",
    "deutsch": "Verlobung und Heirat",
    "audio": "https://textbook.surayt.com/files/22093.mp3"
  },
  "textTitel": {
    "latein": "Ḥubo w Ṭlobo",
    "syrisch": "ܚܘܒܐ ܘܛـܠܳܒܐ",
    "deutsch": "Liebe und Verlobung",
    "audio": "https://textbook.surayt.com/files/22237.mp3"
  },
  "quelle": {
    "name": "Šlomo Surayt",
    "url": "https://textbook.surayt.com/de/Online%20Course/1.16",
    "abgerufen": "2026-11-16"
  },
  "einleitung": [
    {
      "id": "L16-E-01",
      "latein": "U gworo šudoyo yo d aṯto w gawro cayši cam ḥḏoḏe qonunoyiṯ.",
      "syrisch": "ܐܘ ܓܘܳܪܐ ܫܘܕܳܝܐ ܝܐ ܕܐܰܬ݂ܬܐ ܘܓܰܘܪܐ ܥܰܝܫܝ ܥܰܡ ܚܕ݂ܳܕ݂ܶܐ ܩܳܢܘܢܐܝܬ݂.",
      "deutsch": "Die Ehe ist ein rechtsverbindliches Versprechen von Frau und Mann, ein gemeinsames Leben zu führen.",
      "audio": "https://textbook.surayt.com/files/22087.mp3",
      "lektion": 16,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L16-E-02",
      "latein": "Ac cadat du gworo w di mëštuṯo b kul marduṯo šëkël ḥreno ne.",
      "syrisch": "ܐܰܥ ܥܰܕܰܬ ܕܘ ܓܘܳܪܐ ܘܕܝ ܡܷܫܬܘܬ݂ܐ ܒܟܘܠ ܡܰܪܕܘܬ݂ܐ ܫܷܟܷܠ ܚܪܶܢܐ ܢܶܐ.",
      "deutsch": "Die Traditionen bei der Eheschließung und Hochzeit sind in jeder Kultur anders.",
      "audio": "https://textbook.surayt.com/files/22088.mp3",
      "lektion": 16,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L16-E-03",
      "latein": "U Yohannes Holandoyo yo w i Maryam Suryayto yo. Këbci gawri cam ḥḏoḏe.",
      "syrisch": "ܐܘ ܝܳܗܰܢܢܶܣ ܗܳܠܰܢܕܳܝܐ ܝܐ ܘܐܝ ܡܰܪܝܰܡ ܣܘܪܝܰܝܬܐ ܝܐ. ܟܐܷܒܥܝ ܓܰܘܪܝ ܥܰܡ ܚܕ݂ܳܕ݂ܶܐ.",
      "deutsch": "Johannes ist ein Niederländer und Maryam eine Aramäerin/Assyrerin. Sie wollen heiraten.",
      "audio": "https://textbook.surayt.com/files/23155.mp3",
      "lektion": 16,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L16-E-04",
      "latein": "At tre ste koṯën me tarte mardwoṯe friše.",
      "syrisch": "ܐܰܬ ܬܪܶܐ ܣܬܶܐ ܟܐܬ݂ܷܢ ܡܶܐ ܬܰܪܬܶܐ ܡܰܪܕܘܳܬ݂ܶܐ ܦܪܝܫܶܐ.",
      "deutsch": "Sie beide kommen jeweils von einer anderen Kultur.",
      "audio": "https://textbook.surayt.com/files/22091.mp3",
      "lektion": 16,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L16-E-05",
      "latein": "Gëd ḥozina ucdo aydarbo i ḥubo yariwo acmayye mi lqayto qamayto.",
      "syrisch": "ܓܷܕ ܚܳܙܝܢܰܐ ܐܘܥܕܐ ܐܰܝܕܰܪܒܐ ܐܝ ܚܘܒܐ ܝܰܪܝܘܐ ܐܰܥܡܰܝـܝܶܗ ܡܝ ܠܩܰܝܬܐ ܩܰܡܰܝܬܐ.",
      "deutsch": "Wir werden nun erfahren, wie bei ihnen vom ersten Treffen an die Liebe wuchs.",
      "audio": "https://textbook.surayt.com/files/22092.mp3",
      "lektion": 16,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    }
  ],
  "text": [
    {
      "id": "L16-D-01",
      "latein": "Maryam, i barṯo di Saro w du Aday, yariwo w hawyo claymṯo.",
      "syrisch": "ܐܝ ܡܰܪܝܰܡ، ܐܝ ܒܰܪܬ݂ܐ ܕܝ ܣܰܪܐ ܘܕܘ ܐܰܕܰܝ، ܝܰܪܝܘܐ ܘܗܰܘܝܐ ܥܠܰܝܡܬ݂ܐ.",
      "deutsch": "Maryam ist die Tochter von Saro und Aday. Sie ist groß geworden und zu einer jungen Frau herangewachsen.",
      "audio": "https://textbook.surayt.com/files/22122.mp3",
      "lektion": 16,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L16-D-02",
      "latein": "Koqëryo zëdqe bu beṯ-ṣawbo d Amsterdam.",
      "syrisch": "ܟܳܩܷܪܝܐ ܙܷܕܩܶܐ ܒܘ ܒܶܬ݂ ܨܰܘܒܐ ܕܐܰܡܣܬܷܪܕܰܡ.",
      "deutsch": "Sie studiert Jura an der Universität Amsterdam.",
      "audio": "https://textbook.surayt.com/files/22123.mp3",
      "lektion": 16,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L16-D-03",
      "latein": "B ḥa yawmo bu zabno di afṯo koṯe ḥa claymo Holandoyo ëšme Yohannes koyotaw cam gaba.",
      "syrisch": "ܒܚܰܐ ܝܰܘܡܐ ܒܘ ܙܰܒܢܐ ܕܝ ܐܰܦܬ݂ܐ ܟܳܐܬ݂ܶܐ ܚܰܐ ܥܠܰܝܡܐ ܗܳܠܰܢܕܳܝܐ ܐܷܫܡܶܗ ܝܳܗܰܢܢܶܣ ܟܳܝܳܬܰܘ ܥܰܡ ܓܰܒܰܗ.",
      "deutsch": "Eines Tages kommt in der Pause ein niederländischer junger Mann namens Johannes und setzt sich neben sie.",
      "audio": "https://textbook.surayt.com/files/22124.mp3",
      "lektion": 16,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L16-D-04",
      "latein": "“Brix ṣafro”, komar u claymo.",
      "syrisch": "ܒܪܝܟ݂ ܨܰܦܪܐ، ܟܳܐܡܰܪ ܐܘ ܥܠܰܝܡܐ.",
      "deutsch": "„Guten Morgen!“, sagt der Junge.",
      "audio": "https://textbook.surayt.com/files/22125.mp3",
      "lektion": 16,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L16-D-05",
      "latein": "“Brix ṭobo”, komadacro i Maryam.",
      "syrisch": "ܒܪܝܟ݂ ܛܳܒܐ، ܟܳܡܰܕܰܥܪܐ ܐܝ ܡܰܪܝܰܡ.",
      "deutsch": "„Guten Morgen!“, antwortet Maryam.",
      "audio": "https://textbook.surayt.com/files/22126.mp3",
      "lektion": 16,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L16-D-06",
      "latein": "Komawḏci ruḥayye lë ḥḏoḏe, komëjġoli w košotën i qaḥwaṯṯe.",
      "syrisch": "ܟܳܡܰܘܕ݂ܥܝ ܪܘܚܰܝـܝܶܗ ܠܷܚܕ݂ܳܕ݂ܶܐ، ܟܳܡܷܔܓ݂ܳܠܝ ܘܟܳܫܳܬܷܢ ܐܝ ܩܰܚܘܰܬ݂ܬ݂ܶܗ.",
      "deutsch": "Sie stellen sich einander vor und trinken dabei ihren Kaffee.",
      "audio": "https://textbook.surayt.com/files/22127.mp3",
      "lektion": 16,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L16-D-07",
      "latein": "Hawxa mdawamme u mamlo hul d tayimo i afṯo.",
      "syrisch": "ܗܰܘܟ݂ܰܐ ܡܕܰܘܰܡܡܶܗ ܐܘ ܡܰܡܠܐ ܗܘܠ ܕܬܰܝـܝܡܐ ܐܝ ܐܰܦܬ݂ܐ.",
      "deutsch": "So unterhielten sie sich bis zum Ende der Pause.",
      "audio": "https://textbook.surayt.com/files/22134.mp3",
      "lektion": 16,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L16-D-08",
      "latein": "Bëṯër ṭlëbbe xaṭër w kul ḥa azze lu hërgayḏe.",
      "syrisch": "ܒܷܬ݂ܷܪ ܛܠܷܒܒܶܗ ܟ݂ܰܛܷܪ ܘܟܘܠ ܚܰܐ ܐܰܙܙܶܗ ܠܘ ܗܷܪܓܰܝܕ݂ܶܗ.",
      "deutsch": "Dann verabschiedeten sie sich und jeder ging in seine Lehrveranstaltung.",
      "audio": "https://textbook.surayt.com/files/22135.mp3",
      "lektion": 16,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L16-D-09",
      "latein": "Mi lqaytaṯe i qamayto mšarewalle ar rëġše di ḥubo yërwi b lebe dat tre.",
      "syrisch": "ܡܝ ܠܩܰܝܬܰܬ݂ܶܗ ܐܝ ܩܰܡܰܝܬܐ ܡܫܰܪܶܘܰܠܠܶܗ ܐܰܪ ܪܷܓ݂ܫܶܐ ܕܝ ܚܘܒܐ ܝܷܪܘܝ ܒܰܠ ܠܶܒܶܐ ܕܰܬ ܬܪܶܐ.",
      "deutsch": "Von diesem ersten Treffen an hatten sich bei beiden die Gefühle für einander entwickelt.",
      "audio": "https://textbook.surayt.com/files/22136.mp3",
      "lektion": 16,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L16-D-10",
      "latein": "Bëṯër me haṯe b kul afṯo mjarbiwa d ḥozën ḥḏoḏe w ëḏci ḥḏoḏe ṭawtër.",
      "syrisch": "ܒܷܬ݂ܷܪ ܒܟܘܠ ܐܰܦܬ݂ܐ ܡܔܰܪܒܝܘܰܐ ܕܚܳܙܷܢ ܚܕ݂ܳܕ݂ܶܐ ܘܐܷܕ݂ܥܝ ܚܕ݂ܳܕ݂ܶܐ ܛܰܘܬܷܪ.",
      "deutsch": "Danach versuchten sie sich in jeder Pause zu sehen, um sich gegenseitig besser kennen zu lernen.",
      "audio": "https://textbook.surayt.com/files/22137.mp3",
      "lektion": 16,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L16-D-11",
      "latein": "I Maryam w u Yohannes mdawamme hawxa.",
      "syrisch": "ܐܝ ܡܰܪܝܰܡ ܘܐܘ ܝܳܗܰܢܢܶܣ ܡܕܰܘܰܡܡܶܗ ܗܰܘܟ݂ܰܐ.",
      "deutsch": "Maryam und Johannes machten so weiter.",
      "audio": "https://textbook.surayt.com/files/22138.mp3",
      "lektion": 16,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L16-D-12",
      "latein": "Cam u zabno i asiruṯaṯṯe qawyo w zëdtër ftëḥḥe lebayye lë ḥḏoḏe.",
      "syrisch": "ܟܘܠ ܕܐܰܬ݂ܝ ܐܝ ܐܰܣܝܪܘܬ݂ܰܬ݂ܬ݂ܶܗ ܩܰܘܝܐ ܘܙܷܕܬܷܪ ܦܬܷܚܚܶܗ ܠܶܒܰܝـܝܶܗ ܠܷܚܕ݂ܳܕ݂ܶܐ.",
      "deutsch": "Mit der Zeit vertiefte sich ihre Beziehung und sie liebten sich immer mehr.",
      "audio": "https://textbook.surayt.com/files/22139.mp3",
      "lektion": 16,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L16-D-13",
      "latein": "Fayëš lo bëlḥuḏe bu zabno di madrašto ḥozënwa ḥḏoḏe, elo larwal mi madrašto w bi ḥarayto di šabṯo ste nëfqiwa cam ḥḏoḏe.",
      "syrisch": "ܦܰܝܷܫ ܠܐ ܒܷܠܚܘܕ݂ܶܗ ܒܘ ܙܰܒܢܐ ܕܝ ܡܰܕܪܰܫܬܐ ܚܳܙܷܢܘܰܐ ܚܕ݂ܳܕ݂ܶܐ، ܐܶܠܐ ܠܰܪܘܰܠ ܡܝ ܡܰܕܪܰܫܬܐ ܘܒܝ ܚܰܪܰܝܬܐ ܕܝ ܫܰܒܬ݂ܐ ܣܬܶܐ ܢܷܦܩܝܘܰܐ ܥܰܡ ܚܕ݂ܳܕ݂ܶܐ.",
      "deutsch": "Nun trafen sie sich nicht mehr nur an der Universität, sondern auch außerhalb der Universität und an Wochenenden gingen sie miteinander aus.",
      "audio": "https://textbook.surayt.com/files/22140.mp3",
      "lektion": 16,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L16-D-14",
      "latein": "I Maryam w u Yohannes rëḥmiwa ḥḏoḏe ġalabe.",
      "syrisch": "ܐܝ ܡܰܪܝܰܡ ܘܐܘ ܝܳܗܰܢܢܶܣ ܪܷܚܡܝܘܰܐ ܚܕ݂ܳܕ݂ܶܐ ܓ݂ܰܠܰܒܶܐ.",
      "deutsch": "Maryam und Johannes waren sehr verliebt.",
      "audio": "https://textbook.surayt.com/files/22141.mp3",
      "lektion": 16,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L16-D-15",
      "latein": "B ḥa yawmo u Yohannes mërle li Maryam: “Ono koroḥamno lax w kobacno ġalabe d gawrat li”.",
      "syrisch": "ܒܚܰܐ ܝܰܘܡܐ ܐܘ ܝܳܗܰܢܢܶܣ ܡܷܪܠܶܗ ܠܝ ܡܰܪܝܰܡ: ܐܳܢܐ ܟܳܪܳܚܰܡܢܐ ܠܰܟ݂ ܘܟܳܐܒܰܥܢܐ ܓ݂ܰܠܰܒܶܐ ܕܓܰܘܪܰܬ ܠܝ.",
      "deutsch": "An einem Tag sagte Johannes zu Maryam: „Ich liebe dich und möchte sehr, dass du mich heiratest.“",
      "audio": "https://textbook.surayt.com/files/22142.mp3",
      "lektion": 16,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L16-D-16",
      "latein": "I Maryam mërla: “Ono ste korëḥmallux w këbcallux.",
      "syrisch": "ܐܝ ܡܰܪܝܰܡ ܡܷܪܠܰܗ: ܐܳܢܐ ܣܬܶܐ ܟܳܪܷܚܡܰܠܠܘܟ݂ ܘܟܐܷܒܥܰܠܠܘܟ݂.",
      "deutsch": "Maryam sagte: „Auch ich liebe dich und möchte dich heiraten.",
      "audio": "https://textbook.surayt.com/files/22143.mp3",
      "lektion": 16,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L16-D-17",
      "latein": "Elo cam haṯe këbcono mšaylono mede ḥreno menux”.",
      "syrisch": "ܐܶܠܐ ܥܰܡ ܗܰܬ݂ܶܐ ܟܐܷܒܥܳܢܐ ܡܫܰܝܠܳܢܐ ܡܶܕܶܐ ܚܪܶܢܐ ܡܶܢܘܟ݂.",
      "deutsch": "Aber trotzdem möchte ich dich etwas Anderes fragen.“",
      "audio": "https://textbook.surayt.com/files/22144.mp3",
      "lektion": 16,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L16-D-18",
      "latein": "“Mën yo? Mën këbcat?”, mërle u Yohannes.",
      "syrisch": "ܡܷܢ ܝܐ؟ ܡܷܢ ܟܐܷܒܥܰܬ؟ ܡܷܪܠܶܗ ܐܘ ܝܳܗܰܢܢܶܣ.",
      "deutsch": "„Was ist es, was möchtest du?“, fragte Johannes.",
      "audio": "https://textbook.surayt.com/files/22145.mp3",
      "lektion": 16,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L16-D-19",
      "latein": "I Maryam mërla: “Këbcono du ṭlobo howe xud i cadayḏan.",
      "syrisch": "ܐܝ ܡܰܪܝܰܡ ܡܷܪܠܰܗ: ܟܐܷܒܥܳܢܐ ܕܘ ܛܠܳܒܐ ܗܳܘܶܐ ܟ݂ܘܕ ܐܝ ܥܰܕܰܝܕ݂ܰܢ.",
      "deutsch": "Maryam antwortete: „Ich möchte, dass die Verlobung unserer Tradition folgt.",
      "audio": "https://textbook.surayt.com/files/22146.mp3",
      "lektion": 16,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L16-D-20",
      "latein": "Yani be babux kolozam saymi wacdo cam be babi xud këmmina ‘lu štoyo di qaḥwa’, lašan du ṭlobo miḏac rušmoyiṯ”.",
      "syrisch": "ܝܰܢܝ ܟܐܷܡܡܳܢܐ ܒܶܐ ܒܰܒܘܟ݂ ܟܳܠܳܙܰܡ ܣܰܝܡܝ ܘܰܥܕܐ ܥܰܡ ܒܶܐ ܒܰܒܝ ܟ݂ܘܕ ܟܐܷܡܡܝܢܰܐ ܠܘ ܫܬܳܝܐ ܕܝ ܩܰܚܘܰܐ، ܠܰܫܰܢ ܕܘ ܛܠܳܒܐ ܡܝܕ݂ܰܥ ܪܘܫܡܐܝܬ݂.",
      "deutsch": "Das heißt, deine Familie muss einen Termin mit meiner Familie vereinbaren zum „Kaffeetrinken“, damit die Verlobung offiziell wird.“",
      "audio": "https://textbook.surayt.com/files/23016.mp3",
      "lektion": 16,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L16-D-21",
      "latein": "U Yohannes mërle “Ṭrowe, layt qëtro”.",
      "syrisch": "ܐܘ ܝܳܗܰܢܢܶܣ ܡܷܪܠܶܗ، ܛܪܳܘܶܐ، ܠܰܝܬ ܩܷܛܪܐ.",
      "deutsch": "Johannes sagte: „In Ordnung, kein Problem.“",
      "audio": "https://textbook.surayt.com/files/23017.mp3",
      "lektion": 16,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L16-D-22",
      "latein": "I emo du Yohannes mtalfanla w sëmla wacdo cam ab be babe di Maryam.",
      "syrisch": "ܐܝ ܐܶܡܐ ܕܘ ܝܳܗܰܢܢܶܣ ܡܬܰܠܦܰܢܠܰܗ ܘܣܷܡܠܰܗ ܘܰܥܕܐ ܥܰܡ ܐܰܒ ܒܶܐ ܒܰܒܶܐ ܕܝ ܡܰܪܝܰܡ.",
      "deutsch": "Die Mutter von Johannes rief an und vereinbarte einen Termin mit der Familie von Maryam.",
      "audio": "https://textbook.surayt.com/files/22149.mp3",
      "lektion": 16,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L16-D-23",
      "latein": "I Maryam ste heš me meqëm mawḏacwayla ab be babe cal i ḥubayḏa w du Yohannes.",
      "syrisch": "ܐܝ ܡܰܪܝܰܡ ܣܬܶܐ ܗܶܫ ܡܶܐ ܡܶܩܷܡ ܡܰܘܕ݂ܰܥܘܰܝܠܰܗ ܐܰܒ ܒܶܐ ܒܰܒܶܐ ܥܰܠ ܐܝ ܚܘܒܰܝܕ݂ܰܗ ܘܕܘ ܝܳܗܰܢܢܶܣ.",
      "deutsch": "Maryam hatte selbst schon vorher ihre Familie über ihre Liebe zu Johannes unterrichtet.",
      "audio": "https://textbook.surayt.com/files/22133.mp3",
      "lektion": 16,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L16-D-24",
      "latein": "Aṯi u yawmo du ṭlobo. U Yohannes šqile u ṣlibo du nišan cam kafo d warde w ḥalyuṯo.",
      "syrisch": "ܐܰܬ݂ܝ ܐܘ ܝܰܘܡܐ ܕܘ ܛܠܳܒܐ، ܐܘ ܝܳܗܰܢܢܶܣ ܫܩܝܠܶܗ ܨܠܝܒܐ ܕܘ ܢܝܫܰܢ ܥܰܡ ܟܰܦܐ ܕܘܰܪܕܶܐ ܘܐܷܫܡܐ ܕܚܰܠܝܘܬ݂ܐ.",
      "deutsch": "Dann kam der Tag der Verlobung. Johannes kaufte das Verlobungskreuz mit einem Blumenstrauß und Süßigkeiten.",
      "audio": "https://textbook.surayt.com/files/22132.mp3",
      "lektion": 16,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L16-D-25",
      "latein": "Azze cam i emo w babo lab be babe di Maryam.",
      "syrisch": "ܐܰܙܙܶܗ ܥܰܡ ܐܝ ܐܶܡܐ ܘܒܰܒܐ ܠܰܒ ܒܶܐ ܒܰܒܶܐ ܕܝ ܡܰܪܝܰܡ.",
      "deutsch": "Er ging zusammen mit seinen Eltern zu den Eltern von Maryam.",
      "audio": "https://textbook.surayt.com/files/22131.mp3",
      "lektion": 16,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L16-D-26",
      "latein": "Bëṯër mu štoyo di qaḥwa, u Yohannes mcalaqle u ṣlibo du nišan bë qḏola di Maryam.",
      "syrisch": "ܒܷܬ݂ܷܪ ܡܘ ܫܬܳܝܐ ܕܝ ܩܰܚܘܰܐ، ܐܘ ܝܳܗܰܢܢܶܣ ܡܥܰܠܰܩܠܶܗ ܐܘ ܨܠܝܒܐ ܕܘ ܢܝܫܰܢ ܒܷܩܕ݂ܳܠܰܗ ܕܝ ܡܰܪܝܰܡ.",
      "deutsch": "Nach dem Kaffeetrinken, hing Johannes der Maryam das Verlobungskreuz um den Hals.",
      "audio": "https://textbook.surayt.com/files/22130.mp3",
      "lektion": 16,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L16-D-27",
      "latein": "At tarte iqaryoṯe mašfacce u lalyo b ḥubo w basimuṯo. Mhanalle i Maryam w u Yohannes bu nišanaṯṯe.",
      "syrisch": "ܐܰܬ ܬܰܪܬܶܐ ܐܝܩܰܪܝܳܬ݂ܶܐ ܡܰܫܦܰܥܥܶܗ ܐܘ ܠܰܠܝܐ ܒܚܘܒܐ ܘܒܰܣܝܡܘܬ݂ܐ. ܡܗܰܢܰܠܠܶܗ ܐܝ ܡܰܪܝܰܡ ܘܐܘ ܝܳܗܰܢܢܶܣ ܒܘ ܢܝܫܰܢܰܬ݂ܬ݂ܳܗ.",
      "deutsch": "Beide Familien verbrachten vergnügt und gesellig den Abend. Sie beglückwünschten Maryam und Johannes zu ihrer Verlobung.",
      "audio": "https://textbook.surayt.com/files/22129.mp3",
      "lektion": 16,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L16-D-28",
      "latein": "Bëṯër mu ṭlobo mšaralle d saymi plan li mëštuṯo.",
      "syrisch": "ܒܷܬ݂ܷܪ ܡܘ ܛܠܳܒܐ ܡܫܰܪܰܠܠܶܗ ܕܣܰܝܡܝ ܦ݁ܠܰܢ ܠܝ ܡܷܫܬܘܬ݂ܐ.",
      "deutsch": "Nach der Verlobung fingen sie an, für die Hochzeit zu planen.",
      "audio": "https://textbook.surayt.com/files/22128.mp3",
      "lektion": 16,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    }
  ],
