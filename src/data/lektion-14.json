    "deutsch": "Beim Arzt",
    "audio": "https://textbook.surayt.com/files/22504.ttf"
  },
  "quelle": {
    "name": "Šlomo Surayt",
    "url": "https://textbook.surayt.com/de/Online%20Course/1.14",
    "abgerufen": "2026-11-16"
  },
  "einleitung": [
    {
      "id": "L14-E-01",
      "latein": "B ḥa yawmo bëṯër mu cwodo aṯi u Aday lu bayto.",
      "syrisch": "ܒܚܰܐ ܝܰܘܡܐ ܒܷܬ݂ܷܪ ܡܘ ܥܘܳܕܐ ܐܰܬ݂ܝ ܐܘ ܐܰܕܰܝ ܠܘ ܒܰܝܬܐ.",
      "deutsch": "Eines Tages kam Aday von der Arbeit.",
      "audio": "https://textbook.surayt.com/files/22474.mp3",
      "lektion": 14,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L14-E-02",
      "latein": "“Šlomo, ḥabëbto!” mërle u Aday li Saro.",
      "syrisch": "ܫܠܳܡܐ ܚܰܒܷܒܬܐ، ܡܷܪܠܶܗ ܐܘ ܐܰܕܰܝ ܠܝ ܣܰܪܐ.",
      "deutsch": "“Hallo Schatz!” sagte Aday zu Saro.",
      "audio": "https://textbook.surayt.com/files/22475.mp3",
      "lektion": 14,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L14-E-03",
      "latein": "I Saro b lebo twiroyo mërla, “b šayno!”.",
      "syrisch": "ܐܝ ܣܰܪܐ ܒܠܶܒܐ ܬܘܝܪܳܝܐ ܡܷܪܠܰܗ، ܒܫܰܝܢܐ.",
      "deutsch": "Saro antwortete betrübt: “Hallo!”",
      "audio": "https://textbook.surayt.com/files/22476.mp3",
      "lektion": 14,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L14-E-04",
      "latein": "“Qay? Mën kit? kul mede ṭawwo yo?” mšayele u Aday.",
      "syrisch": "ܩܰܝ؟ ܡܷܢ ܟܝܬ؟ ܟܘܠ ܡܶܕܶܐ ܛܰܘܘܐ ܝܐ؟ ܡܫܰܝܶܠܶܗ ܐܘ ܐܰܕܰܝ.",
      "deutsch": "“Warum, was ist los, alles in Ordnung?” fragte Aday.",
      "audio": "https://textbook.surayt.com/files/22477.mp3",
      "lektion": 14,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L14-E-05",
      "latein": "“Mayko këḏcono,“ mërla i Saro. ”I aṯto d aḥuni Abrohëm, i Šušan, mtalfanla me Mëḏyaḏ w mërla ‘aḥunax kayiwo yo!’”",
      "syrisch": "ܡܰܝܟܐ ܟܐܷܕ݂ܥܳܢܐ، ܡܷܪܠܰܗ ܐܝ ܣܰܪܐ. ܐܝ ܐܰܬ݂ܬܐ ܕܰܐܚܘܢܝ ܐܰܒܪܳܗܷܡ ܐܝ ܫܘܫܰܢ ܡܬܰܠܦܰܢܠܰܗ ܡܶܐ ܡܷܕ݂ܝܰܕ݂ ܘܡܷܪܠܰܗ ܐܰܚܘܢܰܟ݂ ܟܰܝـܝܘܐ ܝܐ.",
      "deutsch": "“Was weiß ich?” sagte Saro. “Die Frau meines Bruders Abrohëm, Šušan, rief aus Midyat an und sagte mir, ‚dein Bruder ist krank!‘“",
      "audio": "https://textbook.surayt.com/files/22478.mp3",
      "lektion": 14,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L14-E-06",
      "latein": "U Aday mërle, “hano latyo ṭebo mafaṣḥono. Elo bu ḥaylo d Aloho latyo mede yaquro.",
      "syrisch": "ܐܘ ܐܰܕܰܝ ܡܷܪܠܶܗ، ܗܰܢܐ ܠܰܬܝܐ ܛܶܒܐ ܡܰܦܰܨܚܳܢܐ. ܐܶܠܐ ܒܘ ܚܰܝܠܐ ܕܰܐܠܳܗܐ ܠܰܬܝܐ ܡܶܕܶܐ ܝܰܩܘܪܐ.",
      "deutsch": "Aday sagte: „Das ist keine erfreuliche Nachricht. Es ist bestimmt keine große Sache.",
      "audio": "https://textbook.surayt.com/files/22479.mp3",
      "lektion": 14,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L14-E-07",
      "latein": "Kowe d howe mede xayifo. Lo mëḥzonat, tax mtalfnina, ḥozina mën këtle.”",
      "syrisch": "ܟܳܘܶܐ ܕܗܳܘܶܐ ܡܶܕܶܐ ܟ݂ܰܝـܝܦܐ. ܠܐ ܡܷܚܙܳܢܰܬ، ܬܰܟ݂ ܡܬܰܠܦܢܝܢܰܐ، ܚܳܙܝܢܰܐ ܡܷܢ ܟܷܬܠܶܗ.",
      "deutsch": "Es ist möglich, dass es etwas Einfaches ist. Sei nicht traurig. Lass uns anrufen und sehen, was er hat.“",
      "audio": "https://textbook.surayt.com/files/22480.mp3",
      "lektion": 14,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    }
  ],
  "text": [
    {
      "id": "L14-D-01",
      "latein": "Qayëm u Aday komtalfan l Mëḏyaḏ w komšayal cal u barëḥmayḏe.",
      "syrisch": "ܩܰܝܷܡ ܐܘ ܐܰܕܰܝ ܟܳܡܬܰܠܦܰܢ ܠܡܷܕ݂ܝܰܕ݂ ܘܟܳܡܫܰܝܰܠ ܥܰܠ ܐܘ ܒܰܪܷܚܡܰܝܕ݂ܶܗ.",
      "deutsch": "Dann ruft Aday in Midyat an und fragt nach seinem Schwager.",
      "audio": "https://textbook.surayt.com/files/22505.mp3",
      "lektion": 14,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L14-D-02",
      "latein": "I aṯto du barëḥmayḏe këmmo: “Aṯmël mqawmo cal u Abrohëm.",
      "syrisch": "ܐܝ ܐܰܬ݂ܬܐ ܕܘ ܒܰܪܷܚܡܰܝܕ݂ܶܗ ܟܐܷܡܡܐ: ܐܰܬ݂ܡܷܠ ܡܩܰܘܡܐ ܥܰܠ ܐܘ ܐܰܒܪܳܗܷܡ.",
      "deutsch": "Die Frau seines Schwagers sagt: „Gestern brach die Krankheit bei Abrohëm aus.",
      "audio": "https://textbook.surayt.com/files/22506.mp3",
      "lektion": 14,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L14-D-03",
      "latein": "Hiye mërle li: ‘Ašër komaḥësno b ruḥi d latno ṭawwo, riši konoqar, lebi komigawlac, këtli ḥëmto w gušmi kule komarcal.’",
      "syrisch": "ܗܝـܝܶܐ ܡܷܪܠܶܗ ܠܝ: ܐܰܫܷܪ ܟܳܡܰܚܷܣܢܐ ܒܪܘܚܝ ܕܠܰܬܢܐ ܛܰܘܘܐ، ܪܝܫܝ ܟܳܢܳܩܰܪ، ܠܶܒܝ ܟܳܡܝܓܰܘܠܰܥ، ܟܷܬܠܝ ܚܷܡܬܐ ܘܓܘܫܡܝ ܟܘܠܶܗ ܟܳܡܰܪܥܰܠ.",
      "deutsch": "Er sagte zu mir, ‚ich fühle mich nicht gut, ich habe Kopfschmerzen, mir ist übel, ich habe Fieber und mein ganzer Körper zittert.‘.",
      "audio": "https://textbook.surayt.com/files/22507.mp3",
      "lektion": 14,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L14-D-04",
      "latein": "‘E, d howe hawxa kobac d ëzzux lu taxtor,’ mërli le.",
      "syrisch": "ܐܶ، ܕܗܳܘܶܐ ܗܰܘܟ݂ܰܐ ܟܐܒܰܥ ܕܐܷܙܙܘܟ݂ ܠܘ ܬܰܟ݂ܬܳܪ، ܡܷܪܠܝ ܠܶܗ.",
      "deutsch": "Wenn das so ist, musst du zum Arzt, sagte ich zu ihm.",
      "audio": "https://textbook.surayt.com/files/22508.mp3",
      "lektion": 14,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L14-D-05",
      "latein": "“E hawxa. Bëṯër me falge d yawmo mtawbal lu taxtor. Hiw ele darmone, ḥappoṯe w šërub.",
      "syrisch": "ܐܶ ܗܰܘܟ݂ܰܐ، ܒܷܬ݂ܷܪ ܡܶܐ ܦܰܠܓܶܗ ܕܝܰܘܡܐ ܡܬܰܘܒܰܠ ܠܘ ܬܰܟ݂ܬܳܪ. ܗܝܘ ܐܶܠܶܗ ܕܰܪܡܳܢܶܐ، ܚܰܦ݁ܦ݁ܳܬ݂ܶܐ ܘܫܷܪܘܒ.",
      "deutsch": "Nun, so war es. Am Nachmittag wurde er zum Arzt gebracht. Man hat ihm Medikamente, Tabletten und Saft verschrieben.",
      "audio": "https://textbook.surayt.com/files/23434.mp3",
      "lektion": 14,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L14-D-06",
      "latein": "Mir ele, ‘kolozam mëṯnoḥat. iḏa me ucdo l šabṯo lo nayëḥle, kolozam mitadacar naqla ḥreto lu taxtor.’",
      "syrisch": "ܡܝܪ ܐܶܠܶܗ ܟܳܠܳܙܰܡ ܡܷܬ݂ܢܳܚܰܬ. ܐܝܕ݂ܰܐ ܡܶܐ ܐܘܥܕܐ ܠܫܰܒܬ݂ܐ ܠܐ ܢܰܝܷܚܠܶܗ، ܟܳܠܳܙܰܡ ܡܝܬܰܕܥܰܪ ܢܰܩܠܰܐ ܚܪܶܬܐ ܠܘ ܬܰܟ݂ܬܳܪ.",
      "deutsch": "Man sagte zu ihm: ‚Du musst dich ausruhen! Wenn es dir in einer Woche nicht besser geht, dann musst er noch einmal zum Arzt zurückgebracht werden.‘",
      "audio": "https://textbook.surayt.com/files/23435.mp3",
      "lektion": 14,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L14-D-07",
      "latein": "Kale ucdo bu bayto mžido cal u taxt.”",
      "syrisch": "ܟܰܠܶܗ ܐܘܥܕܐ ܒܘ ܒܰܝܬܐ ܡܙ̰ܝܕܐ ܥܰܠ ܐܘ ܬܰܟ݂ܬ.",
      "deutsch": "Jetzt liegt er zuhause im Bett.“",
      "audio": "https://textbook.surayt.com/files/22512.mp3",
      "lektion": 14,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L14-D-08",
      "latein": "”Kibi mëjġalno acme?” Mërle u Aday. “E, e.”.",
      "syrisch": "ܟܝܒܝ ܡܷܔܓ݂ܰܠܢܐ ܐܰܥܡܶܗ؟ ܡܷܪܠܶܗ ܐܘ ܐܰܕܰܝ. ܐܶ، ܐܶ.",
      "deutsch": "„Kann ich mit ihm reden?“ fragte Aday. „Ja, selbstverständlich!“",
      "audio": "https://textbook.surayt.com/files/22513.mp3",
      "lektion": 14,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L14-D-09",
      "latein": "“Šlomo Abrohëm, aydarbo hat?”",
      "syrisch": "ܫܠܳܡܐ ܐܰܒܪܳܗܷܡ، ܐܰܝܕܰܪܒܐ ܗܰܬ؟",
      "deutsch": "„Hallo Abrohëm, wie geht es dir?“",
      "audio": "https://textbook.surayt.com/files/22514.mp3",
      "lektion": 14,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L14-D-10",
      "latein": "“Tawdi ġalabe Aday, kala i Šušan maḥkela be mën hawi acmi,” Komar u Abrohëm.",
      "syrisch": "ܬܰܘܕܝ ܓ݂ܰܠܰܒܶܐ ܐܰܕܰܝ، ܟܰܠܰܗ ܐܝ ܫܘܫܰܢ ܡܰܚܟܶܠܰܗ ܒܶܐ ܡܷܢ ܗܰܘܝ ܐܰܥܡܝ، ܟܐܡܰܪ ܐܘ ܐܰܒܪܳܗܷܡ.",
      "deutsch": "Abrohëm antwortet: „Vielen Dank, Aday, Šušan hat dir ja bereits erzählt, was mit mir geschehen ist.“",
      "audio": "https://textbook.surayt.com/files/22519.mp3",
      "lektion": 14,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L14-D-11",
      "latein": "“Hway moro l ruḥux w Aloho obe lux ḥulmono ṭawwo”, Komar u Aday.",
      "syrisch": "ܗܘܰܝ ܡܳܪܐ ܠܪܘܚܘܟ݂ ܘܐܰܠܳܗܐ ܐܳܒܶܐ ܠܘܟ݂ ܚܘܠܡܳܢܐ ܛܰܘܘܐ، ܟܐܡܰܪ ܐܘ ܐܰܕܰܝ.",
      "deutsch": "Aday sagt: „Achte auf deine Gesundheit, gute Besserung!“",
      "audio": "https://textbook.surayt.com/files/22520.mp3",
      "lektion": 14,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L14-D-12",
      "latein": "Bëṯër b šabto i Saro mtalfanla naqla ḥreto l be Abrohëm. Mšayela i aṯto du aḥunayḏa, be aydarbo hawi u Abrohëm?",
      "syrisch": "ܒܷܬ݂ܷܪ ܒܫܰܒܬ݂ܐ ܐܝ ܣܰܪܐ ܡܬܰܠܦܰܢܠܰܗ ܢܰܩܠܰܐ ܚܪܶܬܐ ܠܒܶܐ ܐܰܒܪܳܗܷܡ. ܡܫܰܝܶܠܰܗ ܐܝ ܐܰܬ݂ܬܐ ܕܘ ܐܰܚܘܢܰܝܕ݂ܰܗ ܒܶܐ ܐܰܝܕܰܪܒܐ ܗܰܘܝ ܐܘ ܐܰܒܪܳܗܷܡ؟",
      "deutsch": "Nach einer Woche rief Saro noch einmal bei Abrohëm an. Sie erkundigte sich bei der Frau ihres Bruders, wie es um Abrohëm stehe.",
      "audio": "https://textbook.surayt.com/files/22521.mp3",
      "lektion": 14,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L14-D-13",
      "latein": "I Šušan mërla: “haymën heš hawxa yo. Aṯmël mtawbal naqla ḥreto lu taxtor.” “E, mën mir ele?” Mërla i Saro.",
      "syrisch": "ܐܝ ܫܘܫܰܢ ܡܷܪܠܰܗ: ܗܰܝܡܷܢ ܗܶܫ ܗܰܘܟ݂ܰܐ ܝܐ. ܐܰܬ݂ܡܷܠ ܡܬܰܘܒܰܠ ܢܰܩܠܰܐ ܚܪܶܬܐ ܠܘ ܬܰܟ݂ܬܳܪ. ܐܶ، ܡܷܢ ܡܝܪ ܐܶܠܶܗ؟ ܡܷܪܠܰܗ ܐܝ ܣܰܪܐ.",
      "deutsch": "Šušan sagte: „Glaube mir, (sein Zustand ist) unverändert. Gestern wurde er noch einmal zum Arzt gebracht.“ „Nun, was hat man ihm gesagt?“ fragte Saro.",
      "audio": "https://textbook.surayt.com/files/22522.mp3",
      "lektion": 14,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L14-D-14",
      "latein": "“Bëṯër me dë mcayan ṭawwo, mḥawal lab beṯ krihe,” mërla i Šušan.",
      "syrisch": "ܒܷܬ݂ܷܪ ܡܶܐ ܕܷܡܥܰܝܰܢ ܛܰܘܘܐ ܡܚܰܘܰܠ ܠܰܒ ܒܶܬ݂ ܟܪܝܗܶܐ. ܡܷܪܠܰܗ ܐܝ ܫܘܫܰܢ.",
      "deutsch": "Šušan antwortete: „Nachdem er gründlich untersucht wurde, wurde er ins Krankenhaus verlegt.",
      "audio": "https://textbook.surayt.com/files/23436.mp3",
      "lektion": 14,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L14-D-15",
      "latein": "“Tamo mir ele ‘kit kefe bak kulyoṯayḏux! Kobac fayšat adlalyo harke d ḥozina ramḥël mën kiban saymina lux.’",
      "syrisch": "ܬܰܡܐ ܡܝܪ ܐܶܠܶܗ ܟܝܬ ܟܶܦܶܐ ܒܰܟ ܟܘܠܝܳܬ݂ܰܝܕ݂ܘܟ݂. ܟܐܒܰܥ ܦܰܝܫܰܬ ܐܰܕܠܰܠܝܐ ܗܰܪܟܶܐ ܕܚܳܙܝܢܰܐ ܪܰܡܚܷܠ ܡܷܢ ܟܝܒܰܢ ܣܰܝܡܝܢܰܐ ܠܘܟ݂.",
      "deutsch": "Dort wurde ihm gesagt: ‚Es gibt Steine in deinen Nieren. Du musst heute Nacht hier bleiben, morgen sehen wir, was wir für dich tun können.‘",
      "audio": "https://textbook.surayt.com/files/23437.mp3",
      "lektion": 14,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L14-D-16",
      "latein": "Bëṯër aṯyo camšira w mawbela u Abrohëm acma l qelayto ḥreto. Damëx bramšël bab beṯ krihe.",
      "syrisch": "ܒܷܬ݂ܷܪ ܐܰܬ݂ܝܐ ܥܰܡܫܝܪܰܐ ܘܡܰܘܒܶܠܰܗ ܐܘ ܐܰܒܪܳܗܷܡ ܐܰܥܡܰܗ ܠܩܶܠܰܝܬܐ ܚܪܶܬܐ. ܕܰܡܷܟ݂ ܒܪܰܡܫܷܠ ܒܰܒ ܒܶܬ݂ ܟܪܝܗܶܐ.",
      "deutsch": "Danach kam eine Krankenschwester und nahm Abrohëm in ein anderes Zimmer. Er hat gestern die Nacht im Krnankenhaus verbracht.",
      "audio": "https://textbook.surayt.com/files/22524.mp3",
      "lektion": 14,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L14-D-17",
      "latein": "Adṣafro aṯi u taxtor side w mërle le: ‘Gëd obeno lux ḥappoṯe, miḏe d komašërno baḥ ḥappoṯani ak kulyoṯayḏux gëd howën ṭawtër.’",
      "syrisch": "ܐܰܕܨܰܦܪܐ ܐܰܬ݂ܝ ܐܘ ܬܰܟ݂ܬܳܪ ܣܝܕܶܗ ܘܡܷܪܠܶܗ ܠܶܗ: ܓܷܕ ܐܳܒܶܢܐ ܠܘܟ݂ ܚܰܦ݁ܦ݁ܳܬ݂ܶܐ، ܡܝܕ݂ܶܐ ܕܟܳܡܰܫܷܪܢܐ ܒܰܚ ܚܰܦ݁ܦ݁ܳܬ݂ܰܢܝ ܐܰܟ ܟܘܠܝܳܬ݂ܰܝܕ݂ܘܟ݂ ܓܷܕ ܗܳܘܷܢ ܛܰܘܬܷܪ.",
      "deutsch": "Heute morgen kam der Arzt zu ihm und sagte: ‚Ich werde dir Tabletten verschreiben. Denn ich glaube, mit diesen Tabletten wird es deinen Nieren bessergehen.‘",
      "audio": "https://textbook.surayt.com/files/22525.mp3",
      "lektion": 14,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L14-D-18",
      "latein": "E hawxa, mëdlan aḥ ḥappoṯe w dacirina lu bayto”.",
      "syrisch": "ܐܶ ܗܰܘܟ݂ܰܐ، ܡܷܕܠܰܢ ܐܰܚ ܚܰܦ݁ܦ݁ܳܬ݂ܶܐ ܘܕܰܥܝܪܝܢܰܐ ܠܘ ܒܰܝܬܐ.",
      "deutsch": "So nahmen wir die Tabletten und kehrten nach Hause zurück.“",
      "audio": "https://textbook.surayt.com/files/22526.mp3",
      "lektion": 14,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L14-D-19",
      "latein": "“Kibi mëjġolono acme?” Mërla i Saro.",
      "syrisch": "ܟܝܒܝ ܡܷܔܓ݂ܳܠܳܢܐ ܐܰܥܡܶܗ؟ ܡܷܪܠܰܗ ܐܝ ܣܰܪܐ.",
      "deutsch": "Saro fragte: „Kann ich mit ihm sprechen?“",
      "audio": "https://textbook.surayt.com/files/22527.mp3",
      "lektion": 14,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L14-D-20",
      "latein": "“E, kale mëdlax yo.”",
      "syrisch": "ܐܶ، ܟܰܠܶܗ ܡܷܕܠܰܟ݂ ܝܐ.",
      "deutsch": "„Ja, hier hast du ihn!“",
      "audio": "https://textbook.surayt.com/files/22518.mp3",
      "lektion": 14,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L14-D-21",
      "latein": "“Aydarbo hat kako?”",
      "syrisch": "ܐܰܝܕܰܪܒܐ ܗܰܬ ܟܰܟܐ؟",
      "deutsch": "„Wie geht es dir Bruderherz?“",
      "audio": "https://textbook.surayt.com/files/22517.mp3",
      "lektion": 14,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L14-D-22",
      "latein": "“Tawdi ġalabe, hedi hedi koweno ṭawtër,” mërle u Abrohëm.",
      "syrisch": "ܬܰܘܕܝ ܓ݂ܰܠܰܒܶܐ، ܗܶܕܝ ܗܶܕܝ ܟܳܘܶܢܐ ܛܰܘܬܷܪ. ܡܷܪܠܶܗ ܐܘ ܐܰܒܪܳܗܷܡ.",
      "deutsch": "„Vielen Dank, langsam geht es mir besser,“ antwortete Abrohëm.",
      "audio": "https://textbook.surayt.com/files/22516.mp3",
      "lektion": 14,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L14-D-23",
      "latein": "“Ġalabe ṭawwo,” mërla i Saro,” ḥulmono ṭawwo. Fëš bë šlomo”.",
      "syrisch": "ܓ݂ܰܠܰܒܶܐ ܛܰܘܘܐ، ܡܷܪܠܰܗ ܐܝ ܣܰܪܐ، ܚܘܠܡܳܢܐ ܛܰܘܘܐ. ܦܷܫ ܒܷܫܠܳܡܐ.",
      "deutsch": "„Wunderbar!“ freute sich Saro, „Gute Besserung und tschüss!“",
      "audio": "https://textbook.surayt.com/files/22515.mp3",
      "lektion": 14,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    }
  ],
