    "abgerufen": "2026-11-16"
  },
  "einleitung": [
    {
      "id": "L15-E-01",
      "latein": "U spor durošo gušmonoyo yo.",
      "syrisch": "ܐܘ ܣܦ݁ܳܪ ܕܘܪܳܫܐ ܓܘܫܡܳܢܳܝܐ ܝܐ.",
      "deutsch": "Sport ist eine körperliche Betätigung.",
      "audio": "https://textbook.surayt.com/files/22533.mp3",
      "lektion": 15,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L15-E-02",
      "latein": "Heš meqëm me Mšiḥo bë šwacmo w šeṯ w šawci ëšne ay Yawnoye qamoye saymiwa spor.",
      "syrisch": "ܗܶܫ ܡܶܩܷܡ ܡܶܐ ܡܫܝـܚܐ ܒܷܫܘܰܥܡܐ ܘܫܶܬ݂ ܘܫܰܘܥܝ ܐܷܫܢܶܐ ܐܰܝ ܝܰܘܢܳܝܶܐ ܩܰܡܳܝܶܐ ܣܰܝܡܝܘܰܐ ܣܦ݁ܳܪ.",
      "deutsch": "Schon 776 Jahre vor Christus trieben die alten Griechen Sport.",
      "audio": "https://textbook.surayt.com/files/22534.mp3",
      "lektion": 15,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L15-E-03",
      "latein": "Hënne ne am mšatsone dat teštecënye di Olimpiya.",
      "syrisch": "ܗܷܢܢܶܐ ܢܶܐ ܐܰܡ ܡܫܰܬܣܳܢܶܐ ܕܰܬ ܬܶܫܬܶܥܷܢܝܶܐ ܕܝ ܐܳܠܝܡܦ݁ܝܝܰܐ.",
      "deutsch": "Sie sind die Begründer der Olympischen Spiele.",
      "audio": "https://textbook.surayt.com/files/22535.mp3",
      "lektion": 15,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L15-E-04",
      "latein": "U spor këtle macëbḏonuṯo ṭawto cal u hulmono. Mawxa kit sniquṯo ġalabe lu tërmišo du gušmo.",
      "syrisch": "ܐܘ ܣܦ݁ܳܪ ܟܷܬܠܶܗ ܡܰܥܷܒܕ݂ܳܢܘܬ݂ܐ ܛܰܘܬܐ ܥܰܠ ܐܘ ܚܘܠܡܳܢܐ. ܡܰܘܟ݂ܰܐ ܟܝܬ ܣܢܝܩܘܬ݂ܐ ܓ݂ܰܠܰܒܶܐ ܠܘ ܬܷܪܡܝܫܐ ܕܘ ܓܘܫܡܐ.",
      "deutsch": "Der Sport hat guten Einfluss auf die Gesundheit. Deshalb ist viel Bedarf an körperlicher Bewegung.",
      "audio": "https://textbook.surayt.com/files/22536.mp3",
      "lektion": 15,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L15-E-05",
      "latein": "Meqëm me d ḥa mšare bu spor kolozam mfataš harke w tamo cal u spor d komalëq le.",
      "syrisch": "ܡܶܩܷܡ ܡܐ ܕܚܰܐ ܡܫܰܪܶܐ ܒܘ ܣܦ݁ܳܪ ܟܳܠܳܙܰܡ ܡܦܰܬܰܫ ܗܰܪܟܶܐ ܘܬܰܡܐ ܥܰܠ ܐܘ ܣܦ݁ܪ ܕܟܳܡܰܠܷܩ ܠܶܗ.",
      "deutsch": "Bevor man beginnt, Sport zu machen, muss man hier und da nach einer einem passenden Sprotart suchen.",
      "audio": "https://textbook.surayt.com/files/22537.mp3",
      "lektion": 15,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    }
  ],
  "text": [
    {
      "id": "L15-D-01",
      "latein": "U Gabriyel, u abro di Saro w du Aday heš yolufo yo.",
      "syrisch": "ܐܘ ܓܰܒܪܝـܝܶܠ، ܐܘ ܐܰܒܪܐ ܕܝ ܣܰܪܐ ܘܕܘ ܐܰܕܰܝ ܗܶܫ ܝܳܠܘܦܐ ܝܐ.",
      "deutsch": "Gabriyel, Sohn von Saro und Aday, ist noch ein Student.",
      "audio": "https://textbook.surayt.com/files/22560.mp3",
      "lektion": 15,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L15-D-02",
      "latein": "Koqore bu beṯ ṣawbo dë Groningen.",
      "syrisch": "ܟܳܩܳܪܶܐ ܒܘ ܒܶܬ݂ ܨܰܘܒܐ ܕܷܟ݂ܪܳܢܝܢܓܷܢ.",
      "deutsch": "Er studiert an der Universität Groningen.",
      "audio": "https://textbook.surayt.com/files/22561.mp3",
      "lektion": 15,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L15-D-03",
      "latein": "Kowe ġalabe moro lah hërgayḏe.",
      "syrisch": "ܟܳܘܶܐ ܓ݂ܰܠܰܒܶܐ ܡܳܪܐ ܠܰܗ ܗܷܪܓܰܝܕ݂ܶܗ.",
      "deutsch": "Er engagiert sich sehr in seinem Studium.",
      "audio": "https://textbook.surayt.com/files/22562.mp3",
      "lektion": 15,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L15-D-04",
      "latein": "Elo me zabno l zabno kobac soyam spor ste, lašan d mëṯnaḥ mu tacbo w maġ ġame di qrayto.",
      "syrisch": "ܐܶܠܐ ܡܶܐ ܙܰܒܢܐ ܠܙܰܒܢܐ ܟܳܐܒܰܥ ܣܳܝܰܡ ܣܦ݁ܳܪ ܣܬܶܐ، ܠܰܫܰܢ ܕܡܷܬ݂ܢܰܚ ܡܘ ܬܰܥܒܐ ܘܡܰܓ݂ ܓ݂ܰܡܶܐ ܕܝ ܩܪܰܝܬܐ.",
      "deutsch": "Allerdings möchte er ab und zu auch Sport treiben, um sich von den Mühen und Sorgen des Studiums zu erholen.",
      "audio": "https://textbook.surayt.com/files/22563.mp3",
      "lektion": 15,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L15-D-05",
      "latein": "Mawxa cal u darbo du nawlo këzze maltam iḏacṯo cal u spor.",
      "syrisch": "ܡܰܘܟ݂ܰܐ ܥܰܠ ܐܘ ܕܰܪܒܐ ܕܘ ܢܰܘܠܐ ܟܐܷܙܙܶܗ ܡܰܠܬܰܡ ܐܝܕ݂ܰܥܬ݂ܐ ܥܰܠ ܐܘ ܣܦ݁ܳܪ.",
      "deutsch": "Deshalb sammelt er im Internet Informationen zu Sportangeboten.",
      "audio": "https://textbook.surayt.com/files/22564.mp3",
      "lektion": 15,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L15-D-06",
      "latein": "U spor šġimuṯo yo lu nošo.",
      "syrisch": "ܐܘ ܣܦ݁ܳܪ ܫܓ݂ܝܡܘܬ݂ܐ ܝܐ ܠܘ ܢܳܫܐ.",
      "deutsch": "Der Sport ist für den Menschen eine Freizeitbeschäftigung.",
      "audio": "https://textbook.surayt.com/files/22565.mp3",
      "lektion": 15,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L15-D-07",
      "latein": "Ṭawwo yo lu ḥulmono w lu ṭcoyo daġ ġame w du tacbo.",
      "syrisch": "ܛܰܘܘܐ ܝܐ ܠܘ ܚܘܠܡܳܢܐ ܘܠܘ ܛܥܳܝܐ ܕܰܓ݂ ܓ݂ܰܡܶܐ ܘܕܘ ܬܰܥܒܐ.",
      "deutsch": "Er ist gut für die Gesundheit und um Sorgen und Müdigkeit zu vergessen.",
      "audio": "https://textbook.surayt.com/files/22566.mp3",
      "lektion": 15,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L15-D-08",
      "latein": "An noše d kosaymi duroše gušmonoye, komarġši d këtne ḥiṣe, b hawno bahuro w b ḥaylo.",
      "syrisch": "ܐܰܢ ܢܳܫܶܐ ܕܟܳܣܰܝܡܝ ܕܘܪܳܫܶܐ ܓܘܫܡܳܢܳܝܶܐ، ܟܳܡܰܪܓ݂ܫܝ ܕܟܷܬܢܶܐ ܚـܝܨܶܐ، ܗܰܘܢܰܝـܝܶܗ ܒܰܗܘܪܐ ܘܒܚܰـܝܠܐ.",
      "deutsch": "Die Menschen, die Sport treiben, haben das Gefühl, dass sie fit sind, mit hellem Verstand und (guter) Kondition.",
      "audio": "https://textbook.surayt.com/files/22567.mp3",
      "lektion": 15,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L15-D-09",
      "latein": "Kul spor këtle qonune dilonoye, dam mëštacyone kolozam ëḏcënne. Hani bu sucrono kolozam miṭabqi.",
      "syrisch": "ܟܘܠ ܣܦ݁ܳܪ ܟܷܬܠܶܗ ܬܚܘܡܶܐ ܘܩܳܢܘܢܶܐ ܕܝܠܳܢܳܝܶܐ. ܕܰܡ ܡܷܫܬܰܥܝܳܢܶܐ ܟܳܠܳܙܰܡ ܐܷܕ݂ܥܷܢܢܶܗ. ܗܰܢܝ ܒܘ ܣܘܥܪܳܢܐ ܟܳܠܳܙܰܡ ܡܝܛܰܒܩܝ.",
      "deutsch": "Jede Sportart hat ihre eigenen Regeln, die die Sportler kennen müssen. Diese müssen in der Praxis angewandt werden.",
      "audio": "https://textbook.surayt.com/files/22568.mp3",
      "lektion": 15,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L15-D-10",
      "latein": "Kul spor këtle taḥrazto ṯabëtto d ruḥe.",
      "syrisch": "ܟܘܠ ܣܦ݁ܳܪ ܟܷܬܠܶܗ ܬܰܚܪܰܙܬܐ ܬ݂ܰܒܷܬܬܐ ܕܪܘܚܶܗ.",
      "deutsch": "Jede Sportart hat ihr eigenes Programm.",
      "audio": "https://textbook.surayt.com/files/22569.mp3",
      "lektion": 15,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L15-D-11",
      "latein": "Haṯe kowe d huwyo li mdaršuṯo aw l muroyo d cam gudo ḥreto",
      "syrisch": "ܗܰܬ݂ܶܐ ܟܳܘܶܐ ܕܗܘܝܐ ܠܝ ܡܕܰܪܫܘܬ݂ܐ ܐܰܘ ܠܡܘܪܳܝܐ ܕܥܰܡ ܓܘܕܐ ܚܪܶܬܐ.",
      "deutsch": "Dies gilt für das Training oder für ein Spiel mit einer anderen Mannschaft.",
      "audio": "https://textbook.surayt.com/files/22570.mp3",
      "lektion": 15,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L15-D-12",
      "latein": "Am muroye du spor komiṭaksi li fṣiḥuṯo dam mëštawtfone w dam mfarjone, aw ste l iqoro d aṯro, dë mḏito, d ḥuḏro aw ġer ṣbuṯo.",
      "syrisch": "ܐܰܡ ܡܘܪܳܝܶܐ ܕܘ ܣܦ݁ܳܪ ܟܳܡܝܛܰܟܣܝ ܠܝ ܦܨܝـܚܘܬ݂ܐ ܕܰܡ ܡܷܫܬܰܘܬܦܳܢܶܐ ܘܕܰܡ ܡܦܰܪܔܳܢܶܐ، ܐܰܘ ܣܬܶܐ ܠܐܝܩܳܪܐ ܕܐܰܬ݂ܪܐ، ܕܷܡܕ݂ܝܬܐ، ܕܚܘܕ݂ܪܐ ܐܰܘ ܓ݂ܶܪ ܨܒܘܬ݂ܐ.",
      "deutsch": "Die Wettkämpfe im Sport werden organisiert zum Vergnügen der Teilnehmer und Zuschauer, oder zu Ehren eines Landes, einer Stadt, eines Vereins oder einer anderen Sache.",
      "audio": "https://textbook.surayt.com/files/22571.mp3",
      "lektion": 15,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L15-D-13",
      "latein": "U spor ḥfiṭuṯo gušmonayto aw hawnonayto yo, d komisomo b ruḥa aw cam sicto lašan qmoro.",
      "syrisch": "ܐܘ ܣܦ݁ܳܪ ܟܳܘܶܐ ܡܶܐ ܚܦܝܛܘܬ݂ܐ ܓܘܫܡܳܢܰܝܬܐ ܐܰܘ ܗܰܘܢܳܢܰܝܬܐ ܕܟܳܡܝܣܳܡܐ ܒܪܘܚܰܗ ܐܰܘ ܥܰܡ ܣܝܥܬܐ ܠܰܫܰܢ ܩܡܳܪܐ.",
      "deutsch": "Der Sport ist eine körperliche oder geistige Aktivität, die betrieben wird, um erfolgreich zu sein.",
      "audio": "https://textbook.surayt.com/files/22572.mp3",
      "lektion": 15,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L15-D-14",
      "latein": "Maṯlo: Futbol, sloqo d ṭuro aw sḥoyo.",
      "syrisch": "ܡܰܬ݂ܠܐ: ܦܘܬܒܳܠ، ܣܠܳܩܐ ܕܛܘܪܐ ܐܰܘ ܣܚܳܝܐ.",
      "deutsch": "Zum Beispiel: Fußball, Bergsteigen oder Schwimmen.",
      "audio": "https://textbook.surayt.com/files/22573.mp3",
      "lektion": 15,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L15-D-15",
      "latein": "U nišo rišoyo d muroyo, u qmoro yo.",
      "syrisch": "ܐܘ ܢܝܫܐ ܪܝܫܳܝܐ ܕܡܘܪܳܝܐ ܐܘ ܩܡܳܪܐ ܝܐ.",
      "deutsch": "Das Hauptziel eines Wettkampfes ist zu gewinnen.",
      "audio": "https://textbook.surayt.com/files/22578.mp3",
      "lektion": 15,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L15-D-16",
      "latein": "Kolozam howe lu goran daq qonune du spor w lo baz zuze aw b mede ḥreno.",
      "syrisch": "ܟܳܠܳܙܰܡ ܗܳܘܶܐ ܠܘ ܓܳܪܰܢ ܕܰܩ ܩܳܢܘܢܶܐ ܕܘ ܣܦ݁ܳܪ. ܠܐ ܒܰܙ ܙܘܙܶܐ ܐܰܘ ܒܡܶܕܶܐ ܚܪܶܢܐ.",
      "deutsch": "Es muss nach den Regeln des Sports erreicht werden, nicht mit Geld oder anderen (unerlaubten) Mitteln",
      "audio": "https://textbook.surayt.com/files/22577.mp3",
      "lektion": 15,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L15-D-17",
      "latein": "U Gabriyel ḥërle cal šëklat ġalabe du spor, maṯlo:",
      "syrisch": "ܐܘ ܓܰܒܪܝـܝܶܠ ܚܷܪܠܶܗ ܥܰܠ ܫܷܟܠܰܬ ܓ݂ܰܠܰܒܶܐ ܕܘ ܣܦ݁ܳܪ، ܡܰܬ݂ܠܐ:",
      "deutsch": "Gabriyel schaute sich viele Sportarten an, wie z.B.:",
      "audio": "https://textbook.surayt.com/files/22576.mp3",
      "lektion": 15,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L15-D-18",
      "latein": "tërhiṭo d sësye, šyoro d talgo, ḥiṣuṯo d gušmo, rahṭo ḥiṣo, sḥoyo, futbol, handbol, esfir ṭëbliṯo, esfir salo, yudo, kašo, sloqo d ṭuro, qloco d bësëklet w ġer.",
      "syrisch": "ܬܷܪܗܝܛܐ ܕܣܷܣܝܶܐ، ܫܝܳܪܐ ܕܬܰܠܓܐ، ܚܝܨܘܬ݂ܐ ܕܓܘܫܡܐ، ܪܰܗܛܐ ܚܝܨܐ، ܣܚܳܝܐ، ܦܘܬܒܳܠ، ܗܰܢܕܒܳܠ، ܐܶܣܦܝܪ ܛܷܒܠܝܬ݂ܐ، ܐܶܣܦܝܪ ܣܰܠܐ، ܝܘܕܐ، ܟܰܫܐ، ܣܠܳܩܐ ܕܛܘܪܐ، ܩܠܳܥܐ ܕܒܷܣܷܟܠܶܬ ܘܓ݂ܶܪ.",
      "deutsch": "Skifahren, Fitness, Schnelllauf, Schwimmen, Fußball, Handball, Tischtennis, Basketball, Judo, Hockey, Bergsteigen, Radfahren undsoweiter.",
      "audio": "https://textbook.surayt.com/files/22575.mp3",
      "lektion": 15,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L15-D-19",
      "latein": "Bi ḥarayto makṯawle ëšme bu ḥudro du futbol das Suryoye.",
      "syrisch": "ܒܝ ܚܰܪܰܝܬܐ ܡܰܟܬ݂ܰܘܠܶܗ ܐܷܫܡܶܗ ܒܘ ܚܘܕ݂ܪܐ ܕܘ ܦܘܬܒܳܠ ܕܰܣ ܣܘܪܝܳـܝܶܐ.",
      "deutsch": "Schließlich schrieb er sich im Fußballverein der Aramäer/Assyrer ein.",
      "audio": "https://textbook.surayt.com/files/22574.mp3",
      "lektion": 15,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    }
  ],
