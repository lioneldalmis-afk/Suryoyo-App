  },
  "textTitel": {
    "latein": "Iqarṯo",
    "syrisch": "ܐܝܩܰܪܬ݂ܐ",
    "deutsch": "Familie",
    "audio": "https://textbook.surayt.com/de/files/16495.mp3"
  },
  "quelle": {
    "name": "Šlomo Surayt",
    "url": "https://textbook.surayt.com/de/Online%20Course/1.4",
    "abgerufen": "2026-11-16"
  },
  "einleitung": [
    {
      "id": "L04-E-01",
      "latein": "Haṯe iqarṯo Suryayto yo.",
      "syrisch": "ܗܰܬ݂ܶܐ ܐܝܩܰܪܬ݂ܐ ܣܘܪܝܰܝܬܐ ܝܐ.",
      "deutsch": "Das ist eine aramäische/assyrische Familie.",
      "audio": "https://textbook.surayt.com/de/files/16474.mp3",
      "lektion": 4,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L04-E-02",
      "latein": "Ban ëšne daš šawciyat aṯyo me Mëḏyaḏ b Ṭurcabdin l Holanda.",
      "syrisch": "ܒܰܢ ܐܷܫܢܶܐ ܕܰܫ ܫܰܘܥܝـܝܰܬ ܐܰܬ݂ܝܐ ܡܶܐ ܡܷܕ݂ܝܰܕ݂ ܒܛܘܪܥܰܒܕܝܢ ܠܗܳܠܰܢܕܰܐ.",
      "deutsch": "In den siebziger Jahren kam sie aus Midyat im Turabdin in die Niederlande.",
      "audio": "https://textbook.surayt.com/de/files/16475.mp3",
      "lektion": 4,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L04-E-03",
      "latein": "Bu zabnawo ġalabe iqroṯe Suryoye nafiqiwa me Ṭurcabdin, miḏe d këtwa qëṭre.",
      "syrisch": "ܒܘ ܙܰܒܢܰܘܐ ܓ݂ܰܠܰܒܶܐ ܐܝܩܪܳܬ݂ܶܐ ܣܘܪܝܳܝܶܐ ܢܰܦܝܩܝܘܰܐ ܡܶܐ ܛܘܪܥܰܒܕܝܢ، ܡܝܕ݂ܶܐ ܕܟܷܬܘܰܐ ܩܷܛܪܶܐ.",
      "deutsch": "In dieser Zeit zogen viele aramäische/ assyrische Familien aus dem Turabdin weg, weil es dort Probleme gab.",
      "audio": "https://textbook.surayt.com/de/files/16476.mp3",
      "lektion": 4,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L04-E-04",
      "latein": "Ucdo i iqarṯaṯe markawla ruḥa b Holanda.",
      "syrisch": "ܐܘܥܕܐ ܐܝ ܐܝܩܰܪܬ݂ܰܬ݂ܶܐ ܡܰܪܟܰܘܠܰܗ ܪܘܚܰܗ ܒܗܳܠܰܢܕܰܐ.",
      "deutsch": "Jetzt hat sich die Familie in den Niederlanden eingelebt.",
      "audio": "https://textbook.surayt.com/de/files/16477.mp3",
      "lektion": 4,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L04-E-05",
      "latein": "U babo w i emo di iqarṯo kocawdi w an nacime këzzën li madrašto.",
      "syrisch": "ܐܘ ܒܰܒܐ ܘܐܝ ܐܶܡܐ ܕܝ ܐܝܩܰܪܬ݂ܐ ܟܳܥܰܘܕܝ ܘܐܰܢ ܢܰܥܝܡܶܐ ܟܐܷܙܙܷܢ ܠܝ ܡܰܕܪܰܫܬܐ.",
      "deutsch": "Der Vater und die Mutter der Familie arbeiten und die Kinder gehen zur Schule.",
      "audio": "https://textbook.surayt.com/de/files/16478.mp3",
      "lektion": 4,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L04-E-06",
      "latein": "Hawxa kocayši ḥaye cadi b Holanda.",
      "syrisch": "ܗܰܘܟ݂ܰܐ ܟܳܥܰܝܫܝ ܚܰܝܶܐ ܥܰܕܝ ܒܗܳܠܰܢܕܰܐ.",
      "deutsch": "So leben sie ein normales Leben in den Niederlanden.",
      "audio": "https://textbook.surayt.com/de/files/16479.mp3",
      "lektion": 4,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    }
  ],
  "text": [
    {
      "id": "L04-D-01",
      "latein": "I Saro w u Aday aṯto w gawro ne.",
      "syrisch": "ܐܝ ܣܰܪܐ ܘܐܘ ܐܰܕܰܝ ܐܰܬ݂ܬܐ ܘܓܰܘܪܐ ܢܶܐ.",
      "deutsch": "Saro und Aday sind ein Ehepaar.",
      "audio": "https://textbook.surayt.com/de/files/16496.mp3",
      "lektion": 4,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L04-D-02",
      "latein": "I Saro b cëmro dë tmone w tleṯi ëšne yo w u Aday b cëmro d arbci ëšne yo.",
      "syrisch": "ܐܝ ܣܰܪܐ ܒܥܷܡܪܐ ܕܷܬܡܳܢܶܐ ܘܬܠܶܬ݂ܝ ܐܷܫܢܶܐ ܝܐ ܘܐܘ ܐܰܕܰܝ ܒܥܷܡܪܐ ܕܐܰܪܒܥܝ ܐܷܫܢܶܐ ܝܐ.",
      "deutsch": "Saro ist achtunddreißig Jahre alt und Aday ist im Alter von vierzig.",
      "audio": "https://textbook.surayt.com/de/files/16497.mp3",
      "lektion": 4,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L04-D-03",
      "latein": "Këtte arbco nacime, tarte bnoṯe w tre abne.",
      "syrisch": "ܟܷܬܬܶܗ ܐܰܪܒܥܐ ܢܰܥܝܡܶܐ، ܬܰܪܬܶܐ ܒܢܳܬ݂ܶܐ ܘܬܪܶܐ ܐܰܒܢܶܐ.",
      "deutsch": "Sie haben vier Kinder, zwei Mädchen und zwei Jungen.",
      "audio": "https://textbook.surayt.com/de/files/16498.mp3",
      "lektion": 4,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L04-D-04",
      "latein": "I iqarṯaṯe komiḏoco bu ëšmo d Be Marawge.",
      "syrisch": "ܐܝ ܐܝܩܰܪܬ݂ܰܬ݂ܶܐ ܟܳܡܝܕ݂ܳܥܐ ܒܘ ܐܷܫܡܐ ܕܒܶܐ ܡܰܪܰܘܓܶܐ.",
      "deutsch": "Diese Familie ist unter dem Namen Be Marawge bekannt.",
      "audio": "https://textbook.surayt.com/de/files/16499.mp3",
      "lektion": 4,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L04-D-05",
      "latein": "Iqarṯo Suryayto yo w këṯyo me Ṭurcabdin.",
      "syrisch": "ܐܝܩܰܪܬ݂ܐ ܣܘܪܝܰܝܬܐ ܝܐ ܘܟܐܷܬ݂ܝܐ ܡܶܐ ܛܘܪܥܰܒܕܝܢ.",
      "deutsch": "Sie ist eine aramäische/assyrische Familie und kommt aus dem Turabdin.",
      "audio": "https://textbook.surayt.com/de/files/16500.mp3",
      "lektion": 4,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L04-D-06",
      "latein": "I qašto w u qaššo di iqarṯo ste kocayši harke b Holanda.",
      "syrisch": "ܐܝ ܩܰܫܬܐ ܘܐܘ ܩܰܫܫܐ ܕܝ ܐܝܩܰܪܬ݂ܐ ܣܬܶܐ ܟܳܥܰܝܫܝ ܗܰܪܟܶܐ ܒܗܳܠܰܢܕܰܐ.",
      "deutsch": "Auch die Großmutter und der Großvater leben hier in den Niederlanden.",
      "audio": "https://textbook.surayt.com/de/files/16501.mp3",
      "lektion": 4,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L04-D-07",
      "latein": "I iqarṯo d Be Marawge markawla ruḥa b Holanda ṭawwo.",
      "syrisch": "ܐܝ ܐܝܩܰܪܬ݂ܐ ܕܒܶܐ ܡܰܪܰܘܓܶܐ ܡܰܪܟܰܘܠܰܗ ܪܘܚܰܗ ܒܗܳܠܰܢܕܰܐ ܛܰܘܘܐ.",
      "deutsch": "Die Familie Be Marawge hat sich in den Niederlanden gut eingelebt.",
      "audio": "https://textbook.surayt.com/de/files/16502.mp3",
      "lektion": 4,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L04-D-08",
      "latein": "U Aday kocowad xud malfono bi madrašto, i Saro kocawdo b dukano daj jule bi šuqo w an nacime këzzën li madrašto.",
      "syrisch": "ܐܘ ܐܰܕܰܝ ܟܳܥܳܘܰܕ ܟ݂ܘܕ ܡܰܠܦܳܢܐ ܒܝ ܡܰܕܪܰܫܬܐ، ܐܝ ܣܰܪܐ ܟܳܥܰܘܕܐ ܒܕܘܟܰܢܐ ܕܰܔ ܔܘܠܶܐ ܒܝ ܫܘܩܐ ܘܐܰܢ ܢܰܥܝܡܶܐ ܟܐܷܙܙܷܢ ܠـܝ ܡܰܕܪܰܫܬܐ.",
      "deutsch": "Aday arbeitet als Lehrer in der Schule. Saro arbeitet in einem Kleidungsgeschäft in der Einkaufsstraße und die Kinder gehen zur Schule.",
      "audio": "https://textbook.surayt.com/de/files/16503.mp3",
      "lektion": 4,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L04-D-09",
      "latein": "U Aday këtle ḥoṯo w aḥuno gawire b Ṭurcabdin.",
      "syrisch": "ܐܘ ܐܰܕܰܝ ܟܷܬܠܶܗ ܚܳܬ݂ܐ ܘܐܰܚܘܢܐ ܓܰܘܝܪܶܐ ܒܛܘܪܥܰܒܕܝܢ.",
      "deutsch": "Aday hat eine Schwester und einen Bruder im Turabdin, die verheiratet sind.",
      "audio": "https://textbook.surayt.com/de/files/16504.mp3",
      "lektion": 4,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L04-D-10",
      "latein": "I emo w u babo di Saro ste heš b Ṭurcabdin ne, masuwwe, law këbci d nëfqi mu aṯro.",
      "syrisch": "ܐܝ ܐܶܡܐ ܘܐܘ ܒܰܒܐ ܕܝ ܣܰܪܐ ܣܬܶܐ ܗܶܫ ܒܛܘܪܥܰܒܕܝܢ ܢܶܐ، ܡܰܣܘܘܶܗ، ܠܰܘ ܟܐܷܒܥܝ ܕܢܷܦܩܝ ܡܘ ܐܰܬ݂ܪܐ.",
      "deutsch": "Auch Saros Mutter und Vater sind noch im Turabdin, sie sind alt und wollen die Heimat nicht mehr verlassen.",
      "audio": "https://textbook.surayt.com/de/files/16505.mp3",
      "lektion": 4,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L04-D-11",
      "latein": "Lašan di asiruṯo lo mëqṭoco, me zabno l zabno komtalfëni lë ḥḏoḏe.",
      "syrisch": "ܠܰܫܰܢ ܕܝ ܐܰܣܝܪܘܬ݂ܐ ܠܐ ܡܷܩܛܳܥܐ، ܡܶܐ ܙܰܒܢܐ ܠܙܰܒܢܐ ܟܳܡܬܰܠܦܷܢܝ ܠܷܚܕ݂ܳܕ݂ܶܐ.",
      "deutsch": "Damit der Kontakt nicht abbricht, rufen sie sich von Zeit zu Zeit an.",
      "audio": "https://textbook.surayt.com/de/files/16506.mp3",
      "lektion": 4,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L04-D-12",
      "latein": "An nacime ste lašan d lo ṭocën ḥḏoḏe komëjġoli cam an nacime daḥ ḥolone w dac cammone bu talafon.",
      "syrisch": "ܐܰܢ ܢܰܥܝܡܶܐ ܣܬܶܐ ܠܰܫܰܢ ܕܠܐ ܛܳܥܷܢ ܚܕ݂ܳܕ݂ܶܐ ܟܳܡܷܔܓ݂ܳܠܝ ܥܰܡ ܐܰܢ ܢܰܥܝܡܶܐ ܕܰܚ ܚܳܠܳܢܶܐ ܘܥܰܡܡܳܢܶܐ ܒܘ ܬܰܠܰܦܳܢ.",
      "deutsch": "Damit auch die Kinder einander nicht vergessen, sprechen sie mit den Kindern der Onkel am Telefon.",
      "audio": "https://textbook.surayt.com/de/files/16507.mp3",
      "lektion": 4,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L04-D-13",
      "latein": "Kul šato aw tarte ëšne ste kozayri ḥḏoḏe.",
      "syrisch": "ܟܘܠ ܫܰܬܐ ܐܰܘ ܬܰܪܬܶܐ ܐܷܫܢܶܐ ܣܬܶܐ ܟܳܙܰܝܪܝ ܚܕ݂ܳܕ݂ܶܐ.",
      "deutsch": "Jedes Jahr oder alle zwei Jahre besuchen sie sich.",
      "audio": "https://textbook.surayt.com/de/files/16508.mp3",
      "lektion": 4,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L04-D-14",
      "latein": "Hawxa i iqarṯo d Be Marawge komašafco aḥ ḥaye.",
      "syrisch": "ܗܰܘܟ݂ܰܐ ܐܝ ܐܝܩܰܪܬ݂ܐ ܕܒܶܐ ܡܰܪܰܘܓܶܐ ܟܳܡܰܫܰܦܥܐ ܐܰܚ ܚܰܝܶܐ.",
      "deutsch": "So verbringt die Familie Be Marawge ihr Leben.",
      "audio": "https://textbook.surayt.com/de/files/16509.mp3",
      "lektion": 4,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    }
  ],
