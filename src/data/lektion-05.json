{
  "nr": 5,
  "titel": {
    "latein": "Madrašto",
    "syrisch": "ܡܰܕܪܰܫܬܐ",
    "deutsch": "Schule",
    "audio": "https://textbook.surayt.com/files/23579.mp3"
  },
  "textTitel": {
    "latein": "Malfono Aday",
    "syrisch": "ܡܰܠܦܳܢܐ ܐܰܕܰܝ",
    "deutsch": "Der Lehrer Aday",
    "audio": "https://textbook.surayt.com/de/files/16850.mp3"
  },
  "quelle": {
    "name": "Šlomo Surayt",
    "url": "https://textbook.surayt.com/de/Online%20Course/1.5",
    "abgerufen": "2026-11-16"
  },
  "einleitung": [
    {
      "id": "L05-E-01",
      "latein": "I madrašto dukṯo du yulfono yo.",
      "syrisch": "ܐܝ ܡܰܕܪܰܫܬܐ ܕܘܟܬ݂ܐ ܕܘ ܝܘܠܦܳܢܐ ܝܐ.",
      "deutsch": "Die Schule ist ein Ort des Lernens.",
      "audio": "https://textbook.surayt.com/de/files/16827.mp3",
      "lektion": 5,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L05-E-02",
      "latein": "Kibe ḥa yolaf w molaf eba.",
      "syrisch": "ܟܝܒܶܗ ܚܰܐ ܝܳܠܰܦ ܘܡܳܠܰܦ ܐܶܒܰܗ.",
      "deutsch": "Man kann in ihr lernen und lehren.",
      "audio": "https://textbook.surayt.com/de/files/16828.mp3",
      "lektion": 5,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L05-E-03",
      "latein": "Meqëm d howe u Aday malfono b madrašto Holandayto, mšarele d yolaf lišono Holandoyo.",
      "syrisch": "ܡܶܩܷܡ ܕܗܳܘܶܐ ܐܘ ܐܰܕܰܝ ܡܰܠܦܳܢܐ ܒܡܰܕܪܰܫܬܐ ܗܳܠܰܢܕܰܝܬܐ، ܡܫܰܪܶܠܶܗ ܕܝܳܠܰܦ ܠܝܫܳܢܐ ܗܳܠܰܢܕܳܝܐ.",
      "deutsch": "Bevor Aday Lehrer auf einer niederländischen Schule wurde, hat er Niederländisch gelernt.",
      "audio": "https://textbook.surayt.com/de/files/16829.mp3",
      "lektion": 5,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L05-E-04",
      "latein": "Azze l dawro du lišono w b cayni zabno yalëf cal u šbilo du yulfono b Holanda.",
      "syrisch": "ܐܰܙܙܶܗ ܠܕܰܘܪܐ ܕܘ ܠܝܫܳܢܐ ܘܒܥܰܝܢܝ ܙܰܒܢܐ ܝܰܠܷܦ ܥܰܠ ܐܘ ܫܒܝܠܐ ܕܘ ܝܘܠܦܳܢܐ ܒܗܳܠܰܢܕܰܐ.",
      "deutsch": "Er besuchte einen Sprachkurs und zur selben Zeit lernte er die Lehrmethoden in den Niederlanden.",
      "audio": "https://textbook.surayt.com/de/files/16830.mp3",
      "lektion": 5,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L05-E-05",
      "latein": "Hawxa u Aday mḥaḏarle ruḥe lu cwodo.",
      "syrisch": "ܗܰܘܟ݂ܰܐ ܐܘ ܐܰܕܰܝ ܡܚܰܕ݂ܰܪܠܶܗ ܪܘܚܶܗ ܠܘ ܥܘܳܕܐ.",
      "deutsch": "So bereitete sich Aday auf die Arbeit vor.",
      "audio": "https://textbook.surayt.com/de/files/16831.mp3",
      "lektion": 5,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    }
  ],
  "text": [
    {
      "id": "L05-D-01",
      "latein": "U Aday mkamele u dawro šarwoyo du lišono Holandoyo meqëm d cowad.",
      "syrisch": "ܐܘ ܐܰܕܰܝ ܡܟܰܡܶܠܶܗ ܐܘ ܕܰܘܪܐ ܫܰܪܘܳܝܐ ܕܘ ܠܝܫܳܢܐ ܗܳܠܰܢܕܳܝܐ ܡܶܩܷܡ ܕܥܳܘܰܕ.",
      "deutsch": "Aday hat den Anfängerkurs in Niederländisch beendet, bevor er gearbeitet hat.",
      "audio": "https://textbook.surayt.com/de/files/16851.mp3",
      "lektion": 5,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L05-D-02",
      "latein": "Bu dawrano yalëf aydarbo mawḏac ruḥe w aydarbo obe w šoqal cam an noše.",
      "syrisch": "ܒܘ ܕܰܘܪܰܢܐ ܝܰܠܷܦ ܐܰܝܕܰܪܒܐ ܡܰܘܕ݂ܰܥ ܪܘܚܶܗ ܘܐܰܝܕܰܪܒܐ ܐܳܒܶܐ ܘܫܳܩܰܠ ܥܰܡ ܐܰܢ ܢܳܫܶܐ.",
      "deutsch": "In diesem Kurs hat er gelernt, sich vorzustellen und eine Unterhaltung mit anderen zu führen.",
      "audio": "https://textbook.surayt.com/de/files/16852.mp3",
      "lektion": 5,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L05-D-03",
      "latein": "Yalëf ste ġalabe xabre di madrašto xud: qanyo, daftar, kṯowo, luḥo, laḥayto, malfono, sëdro, čanṭa, ṭëbliṯo, qrayto, kṯawto, hërgo, durošo w ġer.",
      "syrisch": "ܝܰܠܷܦ ܣܬܶܐ ܓ݂ܰܠܰܒܶܐ ܟ݂ܰܒܪܶܐ ܕܝ ܡܰܕܪܰܫܬܐ ܟ̣ܘܕ: ܩܰܢܝܐ، ܕܰܦܬܰܪ، ܟܬ݂ܳܘܐ، ܠܘܚܐ، ܠܰܚܰܝܬܐ، ܡܰܠܦܳܢܐ، ܣܷܕܪܐ، ܫ̰ܰܢܛܰܐ، ܛܷܒܠܝܬ݂ܐ، ܩܪܰܝܬܐ، ܟܬ݂ܰܘܬܐ، ܗܷܪܓܐ، ܕܘܪܳܫܐ ܘܓ݂ܶܪ.",
      "deutsch": "Er hat viele Begriffe aus dem Schulalltag gelernt, wie: Stift, Heft, Buch, Tafel, Radiergummi (Schwamm), Lehrer, Klasse, Tasche, Tisch, Lesen, Schreiben, Lektion, Übung und weitere.",
      "audio": "https://textbook.surayt.com/de/files/16853.mp3",
      "lektion": 5,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L05-D-04",
      "latein": "Bëṯër me d qadër maxlaṣ ruḥe bu lišono Holandoyo, mšarele d korax cal cwodo di malfonuṯo.",
      "syrisch": "ܒܷܬ݂ܷܪ ܡܶܐ ܕܩܰܕܷܪ ܡܰܟ݂ܠܰܨ ܪܘܚܶܗ ܒܘ ܠܝܫܳܢܐ ܗܳܠܰܢܕܳܝܐ، ܡܫܰܪܶܠܶܗ ܕܟܳܪܰܟ݂ ܥܰܠ ܥܘܳܕܐ ܕܝ ܡܰܠܦܳܢܘܬ݂ܐ.",
      "deutsch": "Nachdem er die niederländischen Sprache gemeistert hatte, begann er, sich eine Arbeit als Lehrer zu suchen.",
      "audio": "https://textbook.surayt.com/de/files/16854.mp3",
      "lektion": 5,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L05-D-05",
      "latein": "Ucdo u Aday malfono yo. Komolaf Surayt b madrašto Holandayto. Këtle yolufe Holandoye w Suryoye.",
      "syrisch": "ܐܘܥܕܐ ܐܘ ܐܰܕܰܝ ܡܰܠܦܳܢܐ ܝܐ. ܟܳܡܳܠܰܦ ܣܘܪܰܝܬ ܒܡܰܕܪܰܫܬܐ ܗܳܠܰܢܕܰܝܬܐ. ܟܷܬܠܶܗ ܝܳܠܘܦܶܐ ܗܳܠܰܢܕܳܝܶܐ ܘܣܘܪܝܳܝܶܐ.",
      "deutsch": "Jetzt ist Aday Lehrer. Er unterrichtet Surayt an einer niederländischen Schule. Er hat sowohl niederländische als auch aramäische/assyrische Schüler.",
      "audio": "https://textbook.surayt.com/de/files/16855.mp3",
      "lektion": 5,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L05-D-06",
      "latein": "Cam u zabno u Aday komaqwe u lišonayḏe u Holandoyo. Frëšle le bi šabṯo yawmo dilonoyo lu ylofo du lišono Holandoyo.",
      "syrisch": "ܥܰܡ ܐܘ ܙܰܒܢܐ ܐܘ ܐܰܕܰܝ ܟܳܡܰܩܘܶܐ ܐܘ ܠܝܫܳܢܰܝܕ݂ܶܗ ܐܘ ܗܳܠܰܢܕܳܝܐ، ܦܪܷܫܠܶܗ ܒܝ ܫܰܒܬ݂ܐ ܝܰܘܡܐ ܕܝܠܳܢܳܝܐ ܠܘ ܝܠܳܦܐ ܕܘ ܠܝܫܳܢܐ ܗܳܠܰܢܕܳܝܐ.",
      "deutsch": "Mit der Zeit verbessert Aday auch seine niederländische Sprache. Er hat einen Tag in der Woche extra zum Niederländischlernen festgelegt.",
      "audio": "https://textbook.surayt.com/de/files/16856.mp3",
      "lektion": 5,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L05-D-07",
      "latein": "Ġalabe kore bu zabno du hërgo kowe mamlo bayn day yolufe w du malfono.",
      "syrisch": "ܓ݂ܰܠܰܒܶܐ ܟܳܪܶܐ ܒܘ ܙܰܒܢܐ ܕܘ ܗܷܪܓܐ ܟܳܘܶܐ ܡܰܡܠܐ ܒܰܝܢ ܕܰܝ ܝܳܠܘܦܶܐ ܘܕܘ ܡܰܠܦܳܢܐ.",
      "deutsch": "Oftmals gibt es während des Unterrichts Diskussionen zwischen den Schülern und dem Lehrer.",
      "audio": "https://textbook.surayt.com/de/files/16857.mp3",
      "lektion": 5,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L05-D-08",
      "latein": "Karin ḥḏo may yolufe Holandoye yo.",
      "syrisch": "ܟܰܪܝܢ ܚܕ݂ܐ ܡܰܝ ܝܳܠܘܦܶܐ ܗܳܠܰܢܕܳܝܶܐ ܝܐ.",
      "deutsch": "Karin ist eine niederländische Schülerin.",
      "audio": "https://textbook.surayt.com/de/files/16858.mp3",
      "lektion": 5,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L05-D-09",
      "latein": "Komšaylo u Aday: „Ayko yalifat Holandoyo?“",
      "syrisch": "ܟܳܡܫܰܝܠܐ ܐܘ ܐܰܕܰܝ: ܐܰܝܟܐ ܝܰܠܝܦܰܬ ܗܳܠܰܢܕܳܝܐ؟",
      "deutsch": "Sie fragt Aday: „Wo hast du Niederländisch gelernt?“",
      "audio": "https://textbook.surayt.com/de/files/16859.mp3",
      "lektion": 5,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L05-D-10",
      "latein": "Komfane u Aday: „Ono ste xoṯax bad dawre du lišono yalëfno.",
      "syrisch": "ܟܳܡܦܰܢܶܐ ܐܘ ܐܰܕܰܝ: ܐܳܢܐ ܣܬܶܐ ܟ݂ܳܬ݂ܰܟ݂ ܒܰܕ ܕܰܘܪܶܐ ܕܘ ܠܝܫܳܢܐ ܝܰܠܷܦܢܐ.",
      "deutsch": "Aday antwortet: „Ich habe es, wie du, in Sprachkursen gelernt.\"",
      "audio": "https://textbook.surayt.com/de/files/16860.mp3",
      "lektion": 5,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L05-D-11",
      "latein": "Hat qay këbcat yëlfat Surayt?”, komšayal u Aday li Karin.",
      "syrisch": "ܗܰܬ ܩܰܝ ܟܐܷܒܥܰܬ ܝܷܠܦܰܬ ܣܘܪܰܝܬ؟ ܟܳܡܫܰܝܰܠ ܐܘ ܐܰܕܰܝ ܠܝ ܟܰܪܝܢ.",
      "deutsch": "\"Warum möchtest du Surayt lernen?“, fragt Aday Karin.",
      "audio": "https://textbook.surayt.com/de/files/16861.mp3",
      "lektion": 5,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L05-D-12",
      "latein": "Hiya këmmo: „Cal d këtli ḥawrone Suryoye, këbcono fëhmanne inaqla d howina cam ḥḏoḏe.“",
      "syrisch": "ܗܝܝܰܐ ܟܐܷܡܡܐ: ܥܰܠ ܕܟܷܬܠܝ ܚܰܘܪܳܢܶܐ ܣܘܪܝܳܝܶܐ، ܟܐܷܒܥܳܢܐ ܦܷܗܡܰܢܢܶܗ ܐܝܢܰܩܠܰܐ ܕܗܳܘܝܢܰܐ ܥܰܡ ܚܕ݂ܳܕ݂ܶܐ.",
      "deutsch": "Sie antwortet: „Weil ich aramäische/assyrische Freunde habe und ich sie verstehen möchte, wenn wir zusammen sind.“",
      "audio": "https://textbook.surayt.com/de/files/16862.mp3",
      "lektion": 5,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L05-D-13",
      "latein": "Marta yolufto Suryayto yo. U Aday komšayela: Hat qay këbcat yëlfat Surayt?",
      "syrisch": "ܡܰܪܬܰܐ ܝܳܠܘܦܬܐ ܣܘܪܝܰܝܬܐ ܝܐ. ܐܘ ܐܰܕܰܝ ܟܳܡܫܰܝܶܠܰܗ: ܗܰܬ ܩܰܝ ܟܐܷܒܥܰܬ ܝܷܠܦܰܬ ܣܘܪܰܝܬ؟",
      "deutsch": "Marta ist eine aramäische/assyrische Schülerin. Aday fragt sie: „Warum möchtest du Surayt lernen?“",
      "audio": "https://textbook.surayt.com/de/files/16863.mp3",
      "lektion": 5,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L05-D-14",
      "latein": "Hiya këmmo: Cal d këtyo u lišonayḏi.",
      "syrisch": "ܗܝܝܰܐ ܟܐܷܡܡܐ: ܥܰܠ ܕܟܷܬܝܐ ܐܘ ܠܝܫܳܢܰܝܕܝ.",
      "deutsch": "Sie sagt: „Weil es meine Sprache ist.",
      "audio": "https://textbook.surayt.com/de/files/16864.mp3",
      "lektion": 5,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L05-D-15",
      "latein": "U lišonayḏi falqo mi hiyuṯayḏi yo.",
      "syrisch": "ܐܘ ܠܝܫܳܢܰܝܕ݂ܝ ܦܰܠܩܐ ܡܝ ܗܝـܝܘܬܰܝܕ݂ܝ ܝܐ.",
      "deutsch": "Meine Sprache ist ein Teil meiner Identität.",
      "audio": "https://textbook.surayt.com/de/files/16865.mp3",
      "lektion": 5,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L05-D-16",
      "latein": "Bëṯër ḥa mën d yolaf ṭawwo yo.",
      "syrisch": "ܒܷܬ݂ܷܪ ܚܰܐ ܡܷܢ ܕܝܳܠܰܦ ܛܰܘܘܐ ܝܐ.",
      "deutsch": "Außerdem, es ist alles gut, was man lernt.",
      "audio": "https://textbook.surayt.com/de/files/16866.mp3",
      "lektion": 5,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L05-D-17",
      "latein": "Këmmi u yulfono u bahro dat tre yo.",
      "syrisch": "ܟܐܷܡܡܝ: ܐܘ ܝܘܠܦܳܢܐ ܐܘ ܒܰܗܪܐ ܕܰܬ ܬܪܶܐ ܝܐ.",
      "deutsch": "Man sagt, Lernen ist das zweite Licht.“",
      "audio": "https://textbook.surayt.com/de/files/16867.mp3",
      "lektion": 5,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    }
  ],
