{
  "nr": 8,
  "titel": {
    "latein": "Zabno",
    "syrisch": "ܙܰܒܢܐ",
    "deutsch": "Zeit",
    "audio": "https://textbook.surayt.com/de/files/18363.mp3"
  },
  "textTitel": {
    "latein": "Mazlo lu sḥoyo",
    "syrisch": "ܡܰܙܠܐ ܠܘ ܣܚܳـܝܐ",
    "deutsch": "Schwimmausflug",
    "audio": "https://textbook.surayt.com/de/files/18369.mp3"
  },
  "quelle": {
    "name": "Šlomo Surayt",
    "url": "https://textbook.surayt.com/de/Online%20Course/1.8",
    "abgerufen": "2026-11-16"
  },
  "einleitung": [
    {
      "id": "L08-E-01",
      "latein": "I Saro w i Šmuni jirane ne.",
      "syrisch": "ܐܝ ܣܰܪܐ ܘܐܝ ܫܡܘܢܝ ܔܝܪܰܢܶܐ ܢܶܐ.",
      "deutsch": "Saro und Šmuni sind Nachbarn.",
      "audio": "https://textbook.surayt.com/de/files/18364.mp3",
      "lektion": 8,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L08-E-02",
      "latein": "Me zabno l zabno konëfqi cam ḥḏoḏe li šuqo, lu sḥoyo aw l mede ḥreno.",
      "syrisch": "ܡܶܐ ܙܰܒܢܐ ܠܙܰܒܢܐ ܟܳܢܷܦܩܝ ܥܰܡ ܚܕ݂ܳܕ݂ܶܐ ܠܝ ܫܘܩܐ، ܠܘ ܣܚܳܝܐ ܐܰܘ ܠܡܶܕܶܐ ܚܪܶܢܐ.",
      "deutsch": "Von Zeit zu Zeit gehen sie gemeinsam einkaufen, schwimmen oder etwas anderes machen.",
      "audio": "https://textbook.surayt.com/de/files/18365.mp3",
      "lektion": 8,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L08-E-03",
      "latein": "Ramḥël yawme dë cruto yo.",
      "syrisch": "ܪܰܡܚܷܠ ܝܰܘܡܶܗ ܕܷܥܪܘܬܐ ܝܐ.",
      "deutsch": "Morgen ist Freitag.",
      "audio": "https://textbook.surayt.com/de/files/18366.mp3",
      "lektion": 8,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L08-E-04",
      "latein": "At tarte baṭile ne, lo kolozam d cawdi.",
      "syrisch": "ܐܰܬ ܬܰܪܬܶܐ ܒܰܛܝܠܶܐ ܢܶܐ، ܠܐ ܟܳܠܳܙܰܡ ܕܥܰܘܕܝ.",
      "deutsch": "Beide haben frei und müssen nicht arbeiten.",
      "audio": "https://textbook.surayt.com/de/files/18367.mp3",
      "lektion": 8,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L08-E-05",
      "latein": "Lašan d mašëfci u yawmaṯṯe u xalyo basimo, kosaymi wacdo cam ḥḏoḏe d ëzzën lu sḥoyo.",
      "syrisch": "ܠܰܫܰܢ ܕܡܰܫܷܦܥܝ ܐܘ ܝܰܘܡܰܬ݂ܬ݂ܶܗ ܐܘ ܟ݂ܰܠܝܐ ܒܰܣܝܡܐ، ܟܳܣܰܝܡܝ ܘܰܥܕܐ ܥܰܡ ܚܕ݂ܳܕ݂ܶܐ ܕܐܷܙܙܷܢ ܠܘ ܣܚܳܝܐ.",
      "deutsch": "Um ihren freien Tag zu genießen, verabreden sie sich schwimmen zu gehen.",
      "audio": "https://textbook.surayt.com/de/files/18368.mp3",
      "lektion": 8,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    }
  ],
  "text": [
    {
      "id": "L08-D-01",
      "latein": "Šmuni, mën gëd saymat ramḥël? D ëbcat kiban ëzzan lu sḥoyo.",
      "syrisch": "ܫܡܘܢܝ، ܡܷܢ ܓܷܕ ܣܰܝܡܰܬ ܪܰܡܚܷܠ؟ ܕܐܷܒܥܰܬ ܟܝܒܰܢ ܐܷܙܙܰܢ ܠܘ ܣܚܳܝܐ.",
      "deutsch": "Šmuni, was machst du morgen? Wenn du willst, können wir schwimmen gehen.",
      "audio": "https://textbook.surayt.com/de/files/18370.mp3",
      "sprecher": "Saro",
      "lektion": 8,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L08-D-02",
      "latein": "Ašër rënyo ṭawwo yo. Latli mede lë syomo.",
      "syrisch": "ܐܰܫܷܪ ܪܷܢܝܐ ܛܰܘܘܐ ܝܐ. ܠܰܬܠܝ ܡܶܕܶܐ ܠܷܣܝܳܡܐ.",
      "deutsch": "Das ist eine gute Idee. Ich habe nichts zu tun.",
      "audio": "https://textbook.surayt.com/de/files/18371.mp3",
      "sprecher": "Šmuni",
      "lektion": 8,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L08-D-03",
      "latein": "I hawa aydarbo yo?",
      "syrisch": "ܐܝ ܗܰܘܰܐ ܐܰܝܕܰܪܒܐ ܝܐ؟",
      "deutsch": "Wie ist das Wetter?",
      "audio": "https://textbook.surayt.com/de/files/18372.mp3",
      "sprecher": "Šmuni",
      "lektion": 8,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L08-D-04",
      "latein": "I hawa ṭawto yo. Gëd huwyo ḥamšo w cësri (25) darġe.",
      "syrisch": "ܐܝ ܗܰܘܰܐ ܛܰܘܬܐ ܝܐ. ܓܷܕ ܗܘܝܐ ܚܰܡܫܐ ܘܥܷܣܪܝ (25) ܕܰܪܓ݂ܶܐ.",
      "deutsch": "Das Wetter ist gut. Es werden 25 Grad.",
      "audio": "https://textbook.surayt.com/de/files/18373.mp3",
      "sprecher": "Saro",
      "lektion": 8,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L08-D-05",
      "latein": "I saca bak kmo këbcat ëzzan?",
      "syrisch": "ܐܝ ܣܰܥܰܐ ܒܰܟ ܟܡܐ ܟܐܷܒܥܰܬ ܐܷܙܙܰܢ؟",
      "deutsch": "Um wieviel Uhr willst du, dass wir gehen?",
      "audio": "https://textbook.surayt.com/de/files/18374.mp3",
      "sprecher": "Šmuni",
      "lektion": 8,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L08-D-06",
      "latein": "Kiban ḥeloyo ëzzan. Bac csar ṭawwo yo?",
      "syrisch": "ܟܝܒܰܢ ܚܶܠܳܝܐ ܐܷܙܙܰܢ. ܒܰܥ ܥܣܰܪ ܛܰܘܘܐ ܝܐ؟",
      "deutsch": "Wir können früh gehen. Ist es gut um zehn Uhr?",
      "audio": "https://textbook.surayt.com/de/files/18375.mp3",
      "sprecher": "Saro",
      "lektion": 8,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L08-D-07",
      "latein": "E, ṭawwo yo. Mën gëd saymina u yawmo kule tamo?",
      "syrisch": "ܐܶ، ܛܰܘܘܐ ܝܐ. ܡܷܢ ܓܷܕ ܣܰܝܡܝܢܰܐ ܐܘ ܝܰܘܡܐ ܟܘܠܶܗ ܬܰܡܐ؟",
      "deutsch": "Ja, das ist gut. Was machen wir den ganzen Tag dort?",
      "audio": "https://textbook.surayt.com/de/files/18376.mp3",
      "sprecher": "Šmuni",
      "lektion": 8,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L08-D-08",
      "latein": "Gëd soḥina, gëd mšamsina, gëd šotina qaḥwe w falge d yawmo laf i saca tracsar w falge gëd macrina. Hawxa gëd šofac u yawmayḏan.",
      "syrisch": "ܓܷܕ ܣܳܚܝܢܰܐ، ܓܷܕ ܡܫܰܡܣܝܢܰܐ، ܓܷܕ ܫܳܬܝܢܰܐ ܩܰܚܘܰܐ ܘܦܰܠܓܶܗ ܕܝܰܘܡܐ ܠܰܦ ܐܝ ܣܰܥܰܐ ܬܪܰܥܣܰܪ ܘܦܰܠܓܶܗ ܓܷܕ ܡܰܥܪܝܢܰܐ. ܗܰܘܟ݂ܰܐ ܓܷܕ ܫܳܦܰܥ ܐܘ ܝܰܘܡܰܝܕ݂ܰܢ.",
      "deutsch": "Wir werden schwimmen, uns sonnen, Kaffee trinken und mittags gegen halb eins werden wir zu Mittag essen. So werden wir unseren Tag verbringen.",
      "audio": "https://textbook.surayt.com/de/files/18377.mp3",
      "sprecher": "Saro",
      "lektion": 8,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L08-D-09",
      "latein": "Šafiro. Bak kmo këbcat ducrina?",
      "syrisch": "ܫܰܦܝܪܐ. ܒܰܟ ܟܡܐ ܟܐܷܒܥܰܬ ܕܘܥܪܝܢܰܐ؟",
      "deutsch": "Schön. Und wann willst du, dass wir zurückkehren?",
      "audio": "https://textbook.surayt.com/de/files/18378.mp3",
      "sprecher": "Šmuni",
      "lektion": 8,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L08-D-10",
      "latein": "Laf i saca arbac, arbac w falge. Kolozam mḥaḏrono i ḥšamto, miḏe du Aday baš šeṯ koṯe mu cwodo.",
      "syrisch": "ܠܰܦ ܐܝ ܣܰܥܰܐ ܐܰܪܒܰܥ، ܐܰܪܒܰܥ ܘܦܰܠܓܶܗ. ܟܳܠܳܙܰܡ ܡܚܰܕ݂ܪܳܢܐ ܐܝ ܚܫܰܡܬܐ، ܡܝܕ݂ܶܐ ܕܘ ܐܰܕܰܝ ܒܰܫ ܫܶܬ݂ ܟܐܬ݂ܶܐ ܡܘ ܥܘܳܕܐ.",
      "deutsch": "Gegen vier, halb fünf. Ich muss das Abendessen vorbereiten, weil Aday um sechs von der Arbeit kommt.",
      "audio": "https://textbook.surayt.com/de/files/18379.mp3",
      "sprecher": "Saro",
      "lektion": 8,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L08-D-11",
      "latein": "Ṭrowe xud këbcat. Layt qëṭro.",
      "syrisch": "ܛܪܳܘܶܐ ܟ݂ܘܕ ܟܐܷܒܥܰܬ. ܠܰܝܬ ܩܷܛܪܐ.",
      "deutsch": "Ok, wie du willst. Kein Problem.",
      "audio": "https://textbook.surayt.com/de/files/18380.mp3",
      "sprecher": "Šmuni",
      "lektion": 8,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L08-D-12",
      "latein": "Adyawma caṣriye mën gëd saymitu? Toxu šotina qaḥwe sidan.",
      "syrisch": "ܐܰܕܝܰܘܡܰܐ ܥܰܨܪܝـܝܶܐ ܡܷܢ ܓܷܕ ܣܰܝܡܝܬܘ؟ ܬܳܟ݂ܘ ܫܳܬܝܢܰܐ ܩܰܚܘܰܐ ܣܝܕܰܢ.",
      "deutsch": "Was macht ihr heute Abend? Kommt, wir trinken bei uns Kaffee.",
      "audio": "https://textbook.surayt.com/de/files/18381.mp3",
      "sprecher": "Saro",
      "lektion": 8,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L08-D-13",
      "latein": "Ḥozina, iḏa u Afrem latle wacde aw mede lë syomo, gëd oṯina.",
      "syrisch": "ܚܳܙܝܢܰܐ، ܐܝܕ݂ܰܐ ܐܘ ܐܰܦܪܶܡ ܠܰܬܠܶܗ ܘܰܥܕܶܐ ܐܰܘ ܡܶܕܶܐ ܠܷܣܝܳܡܐ، ܓܷܕ ܐܳܬ݂ܝܢܰܐ.",
      "deutsch": "Mal schauen, wenn Afrem keine Termine hat oder etwas anderes tun muss, kommen wir.",
      "audio": "https://textbook.surayt.com/de/files/18382.mp3",
      "sprecher": "Šmuni",
      "lektion": 8,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L08-D-14",
      "latein": "Šafiro, fëš bë šlomo, hul adcaṣriye.",
      "syrisch": "ܫܰܦܝܪܐ، ܦܷܫ ܒܷܫܠܳܡܐ، ܗܘܠ ܐܰܕܥܰܨܪܝـܝܶܐ.",
      "deutsch": "Schön, auf Wiedersehen, bis heute Abend.",
      "audio": "https://textbook.surayt.com/de/files/18383.mp3",
      "sprecher": "Saro",
      "lektion": 8,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L08-D-15",
      "latein": "Zax bë šlomo.",
      "syrisch": "ܙܰܟ݂ ܒܷܫܠܳܡܐ.",
      "deutsch": "Auf Wiedersehen.",
      "audio": "https://textbook.surayt.com/de/files/18384.mp3",
      "sprecher": "Šmuni",
      "lektion": 8,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    }
  ],
