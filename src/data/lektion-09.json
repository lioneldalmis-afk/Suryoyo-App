{
  "nr": 9,
  "titel": {
    "latein": "Surgoḏo",
    "syrisch": "ܣܘܪܓܳܕ݂ܐ",
    "deutsch": "Kalender",
    "audio": "https://textbook.surayt.com/de/files/18965.mp3"
  },
  "quelle": {
    "name": "Šlomo Surayt",
    "url": "https://textbook.surayt.com/de/Online%20Course/1.9",
    "abgerufen": "2026-11-16"
  },
  "einleitung": [],
  "text": [
    {
      "id": "L09-D-01",
      "latein": "Bu šuroyo d kul šato konofaq surgoḏo ḥaṯo.",
      "syrisch": "ܒܘ ܫܘܪܳܝܐ ܕܟܘܠ ܫܰܬܐ ܟܳܢܳܦܰܩ ܣܘܪܓܳܕ݂ܐ ܚܰܬ݂ܐ.",
      "deutsch": "Zum Beginn jedes Jahres kommt ein neuer Kalender heraus.",
      "audio": "https://textbook.surayt.com/de/files/18966.mp3",
      "lektion": 9,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L09-D-02",
      "latein": "Cal u surgoḏo komaḥwën ay yarḥe, aš šabe w ay yawme di šato.",
      "syrisch": "ܥܰܠ ܐܘ ܣܘܪܓܳܕ݂ܐ ܟܳܡܰܚܘܷܢ ܐܰܝ ܝܰܪܚܶܐ، ܐܰܫ ܫܰܒܶܐ ܘܐܰܝ ܝܰܘܡܶܐ ܕܝ ܫܰܬܐ.",
      "deutsch": "Im Kalender sind die Monate, Wochen und Tage des Jahres zu sehen.",
      "audio": "https://textbook.surayt.com/de/files/18967.mp3",
      "lektion": 9,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L09-D-03",
      "latein": "Bu surgoḏo kiban ḥozina ay yawme dac ceḏe w dab baṭlone.",
      "syrisch": "ܒܘ ܣܘܪܓܳܕ݂ܐ ܟܝܒܰܢ ܚܳܙܝܢܰܐ ܐܰܝ ܝܰܘܡܶܐ ܕܰܥ ܥܶܕ݂ܶܐ ܘܕܰܒ ܒܰܛܠܳܢܶܐ.",
      "deutsch": "Wir können im Kalender die Fest- und Feiertage sehen.",
      "audio": "https://textbook.surayt.com/de/files/18968.mp3",
      "lektion": 9,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L09-D-04",
      "latein": "Lašan u surgoḏo mëḥze šafiro, komaḥtina ebe ṣërtoṯe.",
      "syrisch": "ܠܰܫܰܢ ܐܘ ܣܘܪܓܳܕ݂ܐ ܡܷܚܙܶܐ ܫܰܦܝܪܐ، ܟܳܡܰܚܬܝܢܰܐ ܐܶܒܶܗ ܨܷܪܬܳܬ݂ܶܐ.",
      "deutsch": "Damit der Kalender schön aussieht, fügen wir Bilder ein,",
      "audio": "https://textbook.surayt.com/de/files/18969.mp3",
      "lektion": 9,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L09-D-05",
      "latein": "Ṣërtoṯe d komaliqi lu zabno di šato.",
      "syrisch": "ܨܷܪܬܳܬ݂ܶܐ ܕܟܳܡܱܠܝܩܝ ܠܘ ܙܰܒܢܐ ܕܝ ܫܰܬܐ.",
      "deutsch": "die zu den Jahreszeiten passen.",
      "audio": "https://textbook.surayt.com/de/files/18970.mp3",
      "lektion": 9,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L09-D-06",
      "latein": "Ay yawme daḥ ḥušabe, dac ceḏe w dab baṭlone komëkṯowi b gawno semoqo.",
      "syrisch": "ܐܰܝ ܝܰܘܡܶܐ ܕܰܚ ܚܘܫܰܒܶܐ، ܕܰܥ ܥܶܕ݂ܶܐ ܘܕܰܒ ܒܰܛܠܳܢܶܐ ܟܳܡܷܟܬ݂ܳܘܝ ܒܓܰܘܢܐ ܣܶܡܳܩܐ.",
      "deutsch": "Die Sonntage, Fest- und Feiertage werden in roter Farbe eingetragen.",
      "audio": "https://textbook.surayt.com/de/files/18971.mp3",
      "lektion": 9,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L09-D-07",
      "latein": "I šato kiba tlëṯmo w ḥamšo w ëšti (365) yawme, tarte w ḥamši (52) šabe w tracsar (12) yarḥe.",
      "syrisch": "ܐܝ ܫܰܬܐ ܟܝܒܰܗ ܬܠܷܬ݂ܡܐ ܘܚܰܡܫܐ ܘܐܷܫܬܝ (365) ܝܰܘܡܶܐ، ܬܰܪܬܶܐ ܘܚܰܡܫܝ (52) ܫܰܒܶܐ ܘܬܪܰܥܣܰܪ (12) ܝܰܪܚܶܐ.",
      "deutsch": "Das Jahr hat 365 Tage, 52 Wochen und 12 Monate.",
      "audio": "https://textbook.surayt.com/de/files/18972.mp3",
      "lektion": 9,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L09-D-08",
      "latein": "Bi šato kit arbco šuḥlofe. B kul šuḥlofo kit tloṯo yarḥe.",
      "syrisch": "ܒܝ ܫܰܬܐ ܟܝܬ ܐܰܪܒܥܐ ܫܘܚܠܳܦܶܐ. ܒܟܘܠ ܫܘܚܠܳܦܐ ܟܝܬ ܬܠܳܬ݂ܐ ܝܰܪܚܶܐ.",
      "deutsch": "Im Jahr gibt es vier Jahreszeiten. Jede Jahreszeitbesteht aus drei Monaten.",
      "audio": "https://textbook.surayt.com/de/files/18973.mp3",
      "lektion": 9,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L09-D-09",
      "latein": "Bu yarḥo kit tleṯi aw ḥa w tleṯi yawme.",
      "syrisch": "ܒܘ ܝܰܪܚܐ ܟܝܬ ܬܠܶܬ݂ܝ ܐܰܘ ܚܰܐ ܘܬܠܶܬ݂ܝ ܝܰܘܡܶܐ.",
      "deutsch": "Der Monat hat 30 oder 31 Tage.",
      "audio": "https://textbook.surayt.com/de/files/18974.mp3",
      "lektion": 9,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L09-D-10",
      "latein": "Bu yarḥo kit arbac aw ḥammëš šabe.",
      "syrisch": "ܒܘ ܝܰܪܚܐ ܟܝܬ ܐܰܪܒܰܥ ܐܰܘ ܚܰܡܡܷܫ ܫܰܒܶܐ.",
      "deutsch": "Der Monat hat vier oder fünf Wochen.",
      "audio": "https://textbook.surayt.com/de/files/18975.mp3",
      "lektion": 9,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L09-D-11",
      "latein": "Bi šabṯo kit šawco yawme.",
      "syrisch": "ܒܝ ܫܰܒܬ݂ܐ ܟܝܬ ܫܰܘܥܐ ܝܰܘܡܶܐ.",
      "deutsch": "Die Woche hat sieben Tage.",
      "audio": "https://textbook.surayt.com/de/files/18976.mp3",
      "lektion": 9,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L09-D-12",
      "latein": "Bu yawmo kit arbac w cësri sacat.",
      "syrisch": "ܒܘ ܝܰܘܡܐ ܟܝܬ ܐܰܪܒܰܥ ܘܥܷܣܪܝ ܣܰܥܰܬ.",
      "deutsch": "Der Tag hat vierundzwanzig Stunden.",
      "audio": "https://textbook.surayt.com/de/files/18977.mp3",
      "lektion": 9,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L09-D-13",
      "latein": "Bi saca kit ëšti daqqat.",
      "syrisch": "ܒܝ ܣܰܥܰܐ ܟܝܬ ܐܷܫܬܝ ܕܰܩܩܰܬ.",
      "deutsch": "Die Stunde hat sechzig Minuten.",
      "audio": "https://textbook.surayt.com/de/files/18978.mp3",
      "lektion": 9,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L09-D-14",
      "latein": "Bi daqqa kit ëšti ṣaniyat.",
      "syrisch": "ܒܝ ܕܰܩܩܰܐ ܟܝܬ ܐܷܫܬܝ ܨܰܢܝـܝܰܬ.",
      "deutsch": "Die Minute hat sechzig Sekunden.",
      "audio": "https://textbook.surayt.com/de/files/18979.mp3",
      "lektion": 9,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    }
  ],
