{
  "nr": 3,
  "titel": {
    "latein": "Šlomo",
    "syrisch": "ܫܠܳܡܐ",
    "deutsch": "Hallo",
    "audio": "https://textbook.surayt.com/de/files/16250.mp3"
  },
  "quelle": {
    "name": "Šlomo Surayt",
    "url": "https://textbook.surayt.com/de/Online%20Course/1.3",
    "abgerufen": "2026-11-15"
  },
  "einleitung": [
    {
      "id": "L03-E-01",
      "latein": "B ḥa yawmo u Afrem konofaq li šuqo. Koloqe bi Saro w u Aday.",
      "syrisch": "ܒܚܰܐ ܝܰܘܡܐ ܐܘ ܐܰܦܪܶܡ ܟܳܢܳܦܰܩ ܠܝ ܫܘܩܐ. ܟܳܠܳـܩܶܐ ܒܝ ܣܰܪܐ ܘܒܘ ܐܰܕܰܝ.",
      "deutsch": "An einem Tag geht Afrem einkaufen. Er trifft Saro und Aday.",
      "audio": "https://textbook.surayt.com/files/21214.mp3",
      "lektion": 3,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L03-E-02",
      "latein": "Drele šlomo aclayye. Bëṯër me dë mšayalle bu šlomo dë ḥḏoḏe, friši w kul ḥa azze lu cwodayḏe.",
      "syrisch": "ܕܪܶܠܶܗ ܫܠܳܡܐ ܐܰܥܠܰܝـܝܶܗ. ܒܷܬ݂ܷܪ ܡܶܐ ܕܷܡܫܰܝܰܠܠܶܗ ܒܘ ܫܠܳܡܐ ܕܷܚܕ݂ܳܕ݂ܶܐ، ܦܪܝܫܝ ܘܟܘܠ ܚܰܐ ܐܰܙܙܶܗ ܠܘ ܥܘܳܕܰܝܕ݂ܶܗ.",
      "deutsch": "Er begrüßte sie. Nachdem sie sich kurz miteinander unterhalten hatten, trennten sie sich, und jeder ging zu seiner Arbeit.",
      "audio": "https://textbook.surayt.com/files/21213.mp3",
      "lektion": 3,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L03-E-03",
      "latein": "Maṣëṯ ucdo cal u mamlo d hawi baynoṯayye:",
      "syrisch": "ܡܰܨܷܬ݂ ܐܘܥܕܐ ܥܰܠ ܐܘ ܡܰܡܠܐ ܕܗܰܘܝ ܒܰܝܢܳܬ݂ܰܝـܝܶܗ:",
      "deutsch": "Hören Sie nun das Gespräch zwischen ihnen:",
      "audio": "https://textbook.surayt.com/files/21212.mp3",
      "lektion": 3,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    }
  ],
  "dialog": [
    {
      "id": "L03-D-01",
      "latein": "Šlomo, ono ëšmi Afrem yo.",
      "syrisch": "ܫܠܳܡܐ، ܐܳܢܐ ܐܷܫܡܝ ܐܰܦܪܶܡ ܝܐ.",
      "deutsch": "Hallo, ich heiße Afrem.",
      "audio": "https://textbook.surayt.com/de/files/16251.mp3",
      "sprecher": "Afrem",
      "lektion": 3,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L03-D-02",
      "latein": "B šayno, ono ëšmi Aday yo. Haṯe i Saro yo, i aṯtayḏi.",
      "syrisch": "ܒܫܰܝܢܐ، ܐܳܢܐ ܐܷܫܡܝ ܐܰܕܰܝ ܝܐ. ܗܰܬ݂ܶܐ ܐܝ ܣܰܪܐ ܝܐ، ܐܝ ܐܰܬ݂ܬܰܝܕ݂ܝ.",
      "deutsch": "Hallo, mein Name ist Aday. Das ist Saro, meine Frau.",
      "audio": "https://textbook.surayt.com/de/files/16252.mp3",
      "sprecher": "Aday",
      "lektion": 3,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L03-D-03",
      "latein": "Oh, šubqono, aḏëcno lxu. Aydarbo hatu? U Gabriyel aydarbo yo?",
      "syrisch": "ܐܳܗ، ܫܘܒܩܳܢܐ، ܐܰܕ݂ܷܥܢܐ ܠܟ݂ܘ. ܐܰܝܕܰܪܒܐ ܗܰܬܘ؟ ܐܘ ܓܰܒܪܝـܝܶܠ ܐܰܝܕܰܪܒܐ ܝܐ؟",
      "deutsch": "Oh, Entschuldigung, (jetzt) habe ich euch erkannt. Wie geht es euch? Wie geht es Gabriyel?",
      "audio": "https://textbook.surayt.com/de/files/16253.mp3",
      "sprecher": "Afrem",
      "lektion": 3,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L03-D-04",
      "latein": "Tawdi, ṭawwe na.",
      "syrisch": "ܬܰܘܕܝ، ܛܰܘܘܶܐ ܢܰܐ.",
      "deutsch": "Danke, uns geht es gut.",
      "audio": "https://textbook.surayt.com/de/files/16254.mp3",
      "sprecher": "Saro w Aday",
      "lektion": 3,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L03-D-05",
      "latein": "U Gabriyel ste ṭawwo yo.",
      "syrisch": "ܐܘ ܓܰܒܪܝـܝܶܠ ܣܬܶܐ ܛܰܘܘܐ ܝܐ.",
      "deutsch": "Gabriyel geht es auch gut.",
      "audio": "https://textbook.surayt.com/de/files/16255.mp3",
      "sprecher": "Saro",
      "lektion": 3,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L03-D-06",
      "latein": "Mën kosaymitu harke?",
      "syrisch": "ܡܷܢ ܟܳܣܰܝܡܝܬܘ ܗܰܪܟܶܐ؟",
      "deutsch": "Was macht ihr hier?",
      "audio": "https://textbook.surayt.com/de/files/16256.mp3",
      "sprecher": "Afrem",
      "lektion": 3,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L03-D-07",
      "latein": "Ašër kokurxina bi šuqo.",
      "syrisch": "ܐܰܫܷܪ ܟܳܟܘܪܟ݂ܝܢܰܐ ܒܝ ܫܘܩܐ.",
      "deutsch": "Nun, wir sind einkaufen.",
      "audio": "https://textbook.surayt.com/de/files/16257.mp3",
      "sprecher": "Saro",
      "lektion": 3,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L03-D-08",
      "latein": "Ṭawwo.",
      "syrisch": "ܛܰܘܘܐ.",
      "deutsch": "Gut.",
      "audio": "https://textbook.surayt.com/de/files/16258.mp3",
      "sprecher": "Afrem",
      "lektion": 3,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L03-D-09",
      "latein": "Hat mayko koṯat?",
      "syrisch": "ܗܰܬ ܡܰܝܟܐ ܟܳܐܬ݂ܰܬ؟",
      "deutsch": "Woher kommst du?",
      "audio": "https://textbook.surayt.com/de/files/16259.mp3",
      "sprecher": "Saro",
      "lektion": 3,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L03-D-10",
      "latein": "Koṯeno mu bayto.",
      "syrisch": "ܟܳܐܬ݂ܶܢܐ ܡܘ ܒܰܝܬܐ.",
      "deutsch": "Ich komme von zu Hause.",
      "audio": "https://textbook.surayt.com/de/files/16261.mp3",
      "sprecher": "Afrem",
      "lektion": 3,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L03-D-11",
      "latein": "Kibi mšayalno lux mede, Aday?",
      "syrisch": "ܟܝܒܝ ܡܫܰܝܰܠܢܐ ܠܘܟ݂ ܡܶܕܶܐ، ܐܰܕܰܝ؟",
      "deutsch": "Kann ich dich etwas fragen, Aday?",
      "audio": "https://textbook.surayt.com/de/files/16262.mp3",
      "sprecher": "Afrem",
      "lektion": 3,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L03-D-12",
      "latein": "E, kibux.",
      "syrisch": "ܐܶ، ܟܝܒܘܟ݂.",
      "deutsch": "Ja, das kannst du.",
      "audio": "https://textbook.surayt.com/de/files/16263.mp3",
      "sprecher": "Aday",
      "lektion": 3,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L03-D-13",
      "latein": "Mën kocawdat?",
      "syrisch": "ܡܷܢ ܟܳܥܰܘܕܰܬ؟",
      "deutsch": "Was arbeitest du?",
      "audio": "https://textbook.surayt.com/de/files/16264.mp3",
      "sprecher": "Afrem",
      "lektion": 3,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L03-D-14",
      "latein": "Kocowadno xud malfono.",
      "syrisch": "ܟܳܥܳܘܰܕܢܐ ܟ݂ܘܕ ܡܰܠܦܳܢܐ.",
      "deutsch": "Ich arbeite als Lehrer.",
      "audio": "https://textbook.surayt.com/de/files/16265.mp3",
      "sprecher": "Aday",
      "lektion": 3,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L03-D-15",
      "latein": "Mën komëlfat?",
      "syrisch": "ܡܷܢ ܟܳܡܷܠܦܰܬ؟",
      "deutsch": "Was unterrichtest du?",
      "audio": "https://textbook.surayt.com/de/files/16266.mp3",
      "sprecher": "Afrem",
      "lektion": 3,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L03-D-16",
      "latein": "Komolafno Surayt.",
      "syrisch": "ܟܳܡܳܠܰܦܢܐ ܣܘܪܰܝܬ.",
      "deutsch": "Ich unterrichte Surayt.",
      "audio": "https://textbook.surayt.com/de/files/16267.mp3",
      "sprecher": "Aday",
      "lektion": 3,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L03-D-17",
      "latein": "Ġalabe ṭawwo.",
      "syrisch": "ܓ݂ܰܠܰܒܶܐ ܛܰܘܘܐ.",
      "deutsch": "Sehr gut.",
      "audio": "https://textbook.surayt.com/de/files/16268.mp3",
      "sprecher": "Afrem",
      "lektion": 3,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L03-D-18",
      "latein": "E, hawxa. Fëš bë šlomo.",
      "syrisch": "ܐܶ، ܗܰܘܟ݂ܰܐ. ܦܷܫ ܒܷܫܠܳܡܐ.",
      "deutsch": "Ja, na dann, auf Wiedersehen!",
      "audio": "https://textbook.surayt.com/de/files/16269.mp3",
      "sprecher": "Saro w Aday",
      "lektion": 3,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    },
    {
      "id": "L03-D-19",
      "latein": "Zoxu bë šlomo.",
      "syrisch": "ܙܳܟ݂ܘ ܒܷܫܠܳܡܐ.",
      "deutsch": "Auf Wiedersehen!",
      "audio": "https://textbook.surayt.com/de/files/16270.mp3",
      "sprecher": "Afrem",
      "lektion": 3,
      "art": "satz",
      "quelle": "lehrbuch",
      "tags": []
    }
  ],
